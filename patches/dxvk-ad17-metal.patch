--- a/src/dxvk/meson.build
+++ b/src/dxvk/meson.build
@@ -1,3 +1,12 @@
+spirv_tools_source = get_option('spirv_tools_source')
+spirv_tools_build = get_option('spirv_tools_build')
+if spirv_tools_source == '' or spirv_tools_build == ''
+  error('Set spirv_tools_source and spirv_tools_build for the Metal sampler specialization fix')
+endif
+spirv_tools_inc = include_directories(spirv_tools_source / 'include')
+spirv_tools_opt = cpp.find_library('SPIRV-Tools-opt', dirs : spirv_tools_build / 'source/opt', static : true)
+spirv_tools_core = cpp.find_library('SPIRV-Tools', dirs : spirv_tools_build / 'source', static : true)
+spirv_tools_dep = declare_dependency(dependencies : [spirv_tools_opt, spirv_tools_core], include_directories : spirv_tools_inc)
 dxvk_shaders = files([
   'shaders/dxvk_blit_frag_1d.frag',
   'shaders/dxvk_blit_frag_2d.frag',
@@ -121,11 +130,12 @@
 
 dxvk_lib = static_library('dxvk', dxvk_src, glsl_generator.process(dxvk_shaders), dxvk_version,
   link_with           : [ util_lib, spirv_lib ],
-  dependencies        : [ thread_dep, vkcommon_dep ],
+  dependencies        : [ thread_dep, vkcommon_dep, spirv_tools_dep ],
   include_directories : [ dxvk_include_path ],
 )
 
