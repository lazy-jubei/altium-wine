 option('enable_d3d11', type : 'boolean', value : true, description: 'Build D3D11')
 option('build_id',     type : 'boolean', value : false)
+
+option('spirv_tools_source', type : 'string', value : '', description : 'SPIRV-Tools source tree')
+option('spirv_tools_build', type : 'string', value : '', description : 'Static Win32 SPIRV-Tools build tree')
