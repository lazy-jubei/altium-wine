@@ -4018,7 +4018,32 @@
 
     return UnlockFile( file, overlapped->Offset, overlapped->OffsetHigh, count_low, count_high );
 }
+
+
+/* Altium 17's model server uses synchronous writes on an overlapped pipe.
+ * Other I/O on that pipe can signal the file before the write has completed.
+ * Use a private completion event for this application's NULL-overlapped writes.
+ */
+static BOOL altium_model_server_pipe( HANDLE file )
+{
+    static LONG process_match;
+    WCHAR path[MAX_PATH], *name;
+    DWORD len;
+    LONG match = process_match;
 
+    if (!match)
+    {
+        len = GetModuleFileNameW( NULL, path, ARRAY_SIZE(path) );
+        match = -1;
+        if (len && len < ARRAY_SIZE(path))
+        {
+            name = wcsrchr( path, '\\' );
+            if (!wcsicmp( name ? name + 1 : path, L"AltiumMS.exe" )) match = 1;
+        }
+        InterlockedCompareExchange( &process_match, match, 0 );
+    }
+    return match == 1 && GetFileType( file ) == FILE_TYPE_PIPE;
+}
 
