+    if (!dc || !(region = NtGdiCreateRectRgn(0, 0, 0, 0))) goto done;
+    if (NtGdiGetRandomRgn(dc, region, SYSRGN | NTGDI_RGN_MONITOR_DPI) <= 0) goto done;
+    dpi = NtUserGetWinMonitorDpi(hwnd, MDT_RAW_DPI);
+    for (child = NtUserGetWindowRelative(hwnd, GW_CHILD); child;
+         child = NtUserGetWindowRelative(child, GW_HWNDNEXT))
+    {
+        BOOL seeded = FALSE, accelerated = FALSE;
+        if (!NtUserIsWindowVisible(child) ||
+            !(NtUserGetWindowLongW(child, GWL_EXSTYLE) & WS_EX_TRANSPARENT)) continue;
+        if ((data = get_win_data(child)))
+        {
+            seeded = data->gdi_readback_view == view && data->gdi_readback_serial;
+            accelerated = !!data->client_view;
+            release_win_data(data);
+        }
+        if (accelerated || !NtUserGetClientRect(child, &rect, dpi)) continue;
+        NtUserMapWindowPoints(child, hwnd, (POINT *)&rect, 2, dpi);
+        interest = CGRectUnion(interest, cgrect_from_rect(rect));
+        if (!seeded) continue;
+        if (!child_region) child_region = NtGdiCreateRectRgn(0, 0, 0, 0);
+        if (!child_region) goto done;
+        NtGdiSetRectRgn(child_region, rect.left, rect.top, rect.right, rect.bottom);
+        NtGdiCombineRgn(region, region, child_region, RGN_DIFF);
+    }
