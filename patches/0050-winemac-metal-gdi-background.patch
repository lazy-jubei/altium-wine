+++ b/dlls/winemac.drv/gdi_readback.h
@@ -0,0 +1,330 @@
+/* Experimental asynchronous readback for GDI/accelerated child composition. */
+#include <pthread.h>
+#include <stdint.h>
+#include <unistd.h>
+
+static unsigned int readback_live_layers;
+
+@interface WineGDIReadbackLayer : WineMetalLayer
+{
+    BOOL readback_initialized;
+    pthread_mutex_t readback_lock;
+    id<MTLCommandQueue> readback_queue;
+    NSData *readback_pixels;
+    NSUInteger readback_stride;
+    CGRect readback_rect, requested_rect;
+    uint64_t readback_serial, presented_serial;
+    BOOL readback_notification_pending;
+    BOOL readback_pending;
+    BOOL readback_stopped;
+    id<MTLTexture> last_texture;
+    id<CAMetalDrawable> last_drawable;
+    void (^readback_ready)(void);
+}
+- (void)captureTexture:(id<MTLTexture>)texture drawable:(id<CAMetalDrawable>)drawable serial:(uint64_t)serial;
+- (void)recordPresentedTexture:(id<MTLTexture>)texture drawable:(id<CAMetalDrawable>)drawable;
+- (void)finishReadbackBuffer:(id<MTLBuffer>)buffer crop:(CGRect)crop bounds:(CGRect)bounds serial:(uint64_t)serial stride:(NSUInteger)stride status:(MTLCommandBufferStatus)status;
+- (void)initializeReadback;
+- (void)captureLastFrame;
+- (void)stopReadback;
+- (void)setRequestedRect:(CGRect)rect ready:(void (^)(void))ready;
+- (NSData *)copyPixelsForRect:(CGRect *)rect since:(uint64_t *)serial stride:(NSUInteger *)stride;
+@end
+
+@implementation WineGDIReadbackLayer
+- (void)initializeReadback
+{
+    if (readback_initialized) return;
+    pthread_mutex_init(&readback_lock, NULL);
+    readback_rect = requested_rect = CGRectNull;
+    readback_initialized = YES;
+    unsigned int alive = __atomic_add_fetch(&readback_live_layers, 1, __ATOMIC_RELAXED);
+    if (getenv("WINE_TEST_GDI_READBACK_LIFETIME"))
+        fprintf(stderr, "[gdi-readback-lifetime] created alive=%u\n", alive);
+}
+
+- (instancetype)init
+{
+    if ((self = [super init])) [self initializeReadback];
+    return self;
+}
+
+- (instancetype)initWithLayer:(id)layer
+{
+    if ((self = [super initWithLayer:layer])) [self initializeReadback];
+    return self;
+}
+
+- (void)dealloc
+{
+    [self stopReadback];
+    [readback_queue release];
+    [readback_pixels release];
+    if (readback_initialized)
+    {
+        pthread_mutex_destroy(&readback_lock);
+        unsigned int alive = __atomic_sub_fetch(&readback_live_layers, 1, __ATOMIC_RELAXED);
+        if (getenv("WINE_TEST_GDI_READBACK_LIFETIME"))
+            fprintf(stderr, "[gdi-readback-lifetime] destroyed alive=%u\n", alive);
+    }
+    [super dealloc];
+}
+
+- (id<CAMetalDrawable>)nextDrawable
+{
+    id<CAMetalDrawable> drawable = [super nextDrawable];
+    id<MTLTexture> texture = drawable.texture;
+    __weak WineGDIReadbackLayer *weak_layer = self;
+    if (drawable)
+        [drawable addPresentedHandler:^(id<MTLDrawable> completed) {
+            WineGDIReadbackLayer *layer = [weak_layer retain];
+            if (layer)
+            {
+                [layer recordPresentedTexture:texture drawable:(id<CAMetalDrawable>)completed];
+                [layer release];
+            }
+        }];
+    return drawable;
+}
+
+- (void)recordPresentedTexture:(id<MTLTexture>)texture drawable:(id<CAMetalDrawable>)drawable
+{
+    id<MTLTexture> previous_texture = nil;
+    id<CAMetalDrawable> previous_drawable = nil;
+    uint64_t serial;
+    pthread_mutex_lock(&readback_lock);
+    serial = ++presented_serial;
+    if (!readback_stopped)
+    {
+        previous_texture = last_texture;
+        previous_drawable = last_drawable;
+        last_texture = [texture retain];
+        last_drawable = [drawable retain];
+    }
+    pthread_mutex_unlock(&readback_lock);
+    [previous_texture release];
+    [previous_drawable release];
+    [self captureTexture:texture drawable:drawable serial:serial];
+}
+
+- (void)stopReadback
+{
+    id<MTLTexture> texture;
+    id<CAMetalDrawable> drawable;
+    id<MTLCommandQueue> queue;
+    NSData *pixels;
+    void (^ready)(void);
+    if (!readback_initialized) return;
+    pthread_mutex_lock(&readback_lock);
+    if (!readback_stopped && getenv("WINE_TEST_GDI_READBACK_LIFETIME"))
+        fprintf(stderr, "[gdi-readback-lifetime] stopping layer=%p retain=%lu\n", self, (unsigned long)self.retainCount);
+    readback_stopped = YES;
+    texture = last_texture; last_texture = nil;
+    drawable = last_drawable; last_drawable = nil;
+    ready = readback_ready; readback_ready = nil;
+    queue = readback_queue; readback_queue = nil;
+    pixels = readback_pixels; readback_pixels = nil;
+    readback_rect = requested_rect = CGRectNull;
+    pthread_mutex_unlock(&readback_lock);
+    [queue release];
+    [pixels release];
+    [texture release];
+    [drawable release];
+    [ready release];
+}
+
+- (void)captureLastFrame
+{
+    id<MTLTexture> texture;
+    id<CAMetalDrawable> drawable;
+    uint64_t serial;
+    pthread_mutex_lock(&readback_lock);
+    serial = presented_serial;
+    texture = [last_texture retain];
+    drawable = [last_drawable retain];
+    pthread_mutex_unlock(&readback_lock);
+    if (texture && drawable) [self captureTexture:texture drawable:drawable serial:serial];
+    [texture release];
+    [drawable release];
+}
+
+- (void)setRequestedRect:(CGRect)rect ready:(void (^)(void))ready
+{
+    void (^previous)(void);
+    pthread_mutex_lock(&readback_lock);
+    if (readback_stopped || CGRectEqualToRect(rect, requested_rect))
+    {
+        pthread_mutex_unlock(&readback_lock);
+        return;
+    }
+    requested_rect = rect;
+    previous = readback_ready;
+    readback_ready = !CGRectIsNull(rect) && !CGRectIsEmpty(rect) ? [ready copy] : nil;
+    pthread_mutex_unlock(&readback_lock);
+    [previous release];
+    [self captureLastFrame];
+}
+
+- (void)captureTexture:(id<MTLTexture>)texture drawable:(id<CAMetalDrawable>)drawable serial:(uint64_t)serial
+{
+    @autoreleasepool
+    {
+        NSUInteger width, height, stride;
+        CGRect crop;
+        MTLPixelFormat format = texture.pixelFormat;
+        if (format != MTLPixelFormatBGRA8Unorm && format != MTLPixelFormatBGRA8Unorm_sRGB) return;
+        pthread_mutex_lock(&readback_lock);
+        CGRect bounds = CGRectMake(0, 0, texture.width, texture.height);
+        crop = CGRectIntersection(CGRectIntegral(requested_rect), bounds);
+        if (readback_stopped || readback_pending || serial != presented_serial || CGRectIsNull(crop) || CGRectIsEmpty(crop) ||
+            crop.size.width > 8192 || crop.size.height > 8192)
+        {
+            pthread_mutex_unlock(&readback_lock);
+            return;
+        }
+        width = crop.size.width;
+        height = crop.size.height;
+        stride = (width * 4 + 255) & ~255;
+        if (!readback_queue) readback_queue = [self.device newCommandQueue];
+        id<MTLBuffer> buffer = [self.device newBufferWithLength:stride * height options:MTLResourceStorageModeShared];
+        if (!readback_queue || !buffer)
+        {
+            pthread_mutex_unlock(&readback_lock);
+            [buffer release];
+            return;
+        }
+        readback_pending = YES;
+        id<MTLCommandQueue> queue = [readback_queue retain];
+        pthread_mutex_unlock(&readback_lock);
+
+        void *held_drawable = (void *)[drawable retain];
+        __weak WineGDIReadbackLayer *weak_layer = self;
+        id<MTLCommandBuffer> command = [queue commandBuffer];
+        id<MTLBlitCommandEncoder> encoder = [command blitCommandEncoder];
+        if (!encoder)
+        {
+            /* Metal can fail command/encoder allocation. No completion will
+             * release our drawable or clear the single-copy gate in that
+             * case. Leave retrying to the next present/request, rather than
+             * spinning while the device is under resource pressure. */
+            [self finishReadbackBuffer:buffer crop:crop bounds:bounds serial:serial stride:stride
+                               status:MTLCommandBufferStatusError];
+            [(id)held_drawable release];
+            [queue release];
+            [buffer release];
+            return;
+        }
+        [encoder copyFromTexture:texture sourceSlice:0 sourceLevel:0 sourceOrigin:MTLOriginMake(crop.origin.x, crop.origin.y, 0)
+                      sourceSize:MTLSizeMake(width, height, 1) toBuffer:buffer destinationOffset:0
+           destinationBytesPerRow:stride destinationBytesPerImage:stride * height];
+        [encoder endEncoding];
+        [command addCompletedHandler:^(id<MTLCommandBuffer> completed) {
+            @autoreleasepool
+            {
+                const char *test_delay = getenv("WINE_TEST_GDI_READBACK_DELAY_MS");
+                int delay = test_delay ? atoi(test_delay) : 0;
+                if (delay > 0 && delay <= 250) usleep(delay * 1000);
+                WineGDIReadbackLayer *layer = [weak_layer retain];
+                if (layer)
+                {
+                    [layer finishReadbackBuffer:buffer crop:crop bounds:bounds serial:serial stride:stride status:completed.status];
+                    [layer release];
+                }
+                [(id)held_drawable release];
+            }
+        }];
+        [command commit];
+        [queue release];
+        [buffer release];
+    }
+}
+
+- (void)finishReadbackBuffer:(id<MTLBuffer>)buffer crop:(CGRect)crop bounds:(CGRect)bounds serial:(uint64_t)serial stride:(NSUInteger)stride status:(MTLCommandBufferStatus)status
+{
+    void (^ready)(void) = nil;
+    BOOL retry = NO;
+    pthread_mutex_lock(&readback_lock);
+    if (!readback_stopped && status == MTLCommandBufferStatusCompleted)
+    {
+        NSData *pixels = [[NSData alloc] initWithBytes:buffer.contents length:stride * (NSUInteger)crop.size.height];
+        if (!pixels)
+        {
+            readback_pending = NO;
+            pthread_mutex_unlock(&readback_lock);
+            return;
+        }
+        [readback_pixels release];
+        readback_pixels = pixels;
+        readback_rect = crop;
+        readback_stride = stride;
+        if (++readback_serial == 1)
+        {
+            const unsigned char *sample = pixels.bytes;
+            fprintf(stderr, "[gdi-readback] cached %lux%lu stride=%lu BGRA=%02x%02x%02x%02x\n",
+                    (unsigned long)crop.size.width, (unsigned long)crop.size.height, (unsigned long)stride,
+                    sample[0], sample[1], sample[2], sample[3]);
+        }
+        /* A child can extend beyond its accelerated parent. Completion only
+         * needs to cover the visible intersection; retrying the full request
+         * would never finish once the GPU stops presenting. */
+        CGRect required = CGRectIntersection(CGRectIntegral(requested_rect), bounds);
+        BOOL covered = CGRectIsNull(required) || CGRectIsEmpty(required) || CGRectContainsRect(crop, required);
+        if (covered && readback_ready && !readback_notification_pending)
+        {
+            ready = [readback_ready copy];
+            readback_notification_pending = YES;
+        }
+        /* A newer present or changed region may have arrived during this
+         * asynchronous copy. Catch up once, then stop when no work remains. */
+        retry = readback_ready && (!covered || serial != presented_serial);
+    }
+    readback_pending = NO;
+    pthread_mutex_unlock(&readback_lock);
+    if (ready)
+    {
+        __weak WineGDIReadbackLayer *weak_layer = self;
+        OnMainThreadAsync(^{
+            WineGDIReadbackLayer *layer = [weak_layer retain];
+            if (layer)
+            {
+                pthread_mutex_lock(&layer->readback_lock);
+                BOOL notify = !layer->readback_stopped;
+                layer->readback_notification_pending = NO;
+                pthread_mutex_unlock(&layer->readback_lock);
+                if (notify) ready();
+                [layer release];
+            }
+            [ready release];
+        });
+    }
+    if (retry) [self captureLastFrame];
+}
+
+- (NSData *)copyPixelsForRect:(CGRect *)rect since:(uint64_t *)serial stride:(NSUInteger *)stride
+{
+    NSMutableData *result = nil;
+    pthread_mutex_lock(&readback_lock);
+    *rect = CGRectIntersection(CGRectIntegral(*rect), readback_rect);
+    if (readback_pixels && *serial != readback_serial && !CGRectIsNull(*rect) && !CGRectIsEmpty(*rect))
+    {
+        NSUInteger width = rect->size.width, height = rect->size.height;
+        const unsigned char *source = readback_pixels.bytes;
+        *stride = width * 4;
+        result = [[NSMutableData alloc] initWithLength:*stride * height];
+        if (!result)
+        {
+            pthread_mutex_unlock(&readback_lock);
+            return nil;
+        }
+        unsigned char *destination = result.mutableBytes;
+        for (NSUInteger y = 0; y < height; y++)
+            memcpy(destination + y * *stride,
+                   source + ((NSUInteger)(rect->origin.y - readback_rect.origin.y) + y) * readback_stride +
+                   (NSUInteger)(rect->origin.x - readback_rect.origin.x) * 4,
+                   *stride);
+        *serial = readback_serial;
+    }
+    pthread_mutex_unlock(&readback_lock);
+    return result;
+}
+@end
