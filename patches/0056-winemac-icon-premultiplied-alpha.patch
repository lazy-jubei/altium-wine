--- a/dlls/winemac.drv/image.c
+++ b/dlls/winemac.drv/image.c
@@ -63,7 +63,10 @@
     for (i = 0, ptr = (DWORD*)color_bits; i < width * height; i++, ptr++)
         if ((has_alpha = (*ptr & 0xff000000) != 0)) break;
 
