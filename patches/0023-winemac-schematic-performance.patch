+/* Is a rectangle covered by the union of complete cached drawings? Checking
+ * the bounding box alone is insufficient: diagonally offset frames leave two
+ * uncached corners. Split at every vertical edge and check the y intervals in
+ * each slab. This also proves coverage throughout an animation, not just at
+ * its endpoints. Coordinates here are logical points in the container layer. */
+static BOOL cached_rectangle(CGRect needed)
+{
+    CGRect rects[PAN_HISTORY];
+    CGFloat edges[2 + 2 * PAN_HISTORY], edge, y, top = CGRectGetMaxY(needed);
+    unsigned int count = 2, i, j;
+
+    edges[0] = CGRectGetMinX(needed);
+    edges[1] = CGRectGetMaxX(needed);
+    for (i = 0; i < history_count; ++i)
+    {
+        rects[i] = history[i].layer.frame;
+        edge = CGRectGetMinX(rects[i]);
+        if (edge > edges[0] && edge < edges[1]) edges[count++] = edge;
+        edge = CGRectGetMaxX(rects[i]);
+        if (edge > edges[0] && edge < edges[1]) edges[count++] = edge;
+    }
+    for (i = 1; i < count; ++i)
+        for (j = i; j && edges[j] < edges[j - 1]; --j)
+        { edge = edges[j]; edges[j] = edges[j - 1]; edges[j - 1] = edge; }
+    for (i = 1; i < count; ++i)
+    {
+        if (edges[i] == edges[i - 1]) continue;
+        y = CGRectGetMinY(needed);
+        while (y < top)
+        {
+            CGFloat next = y;
+            for (j = 0; j < history_count; ++j)
+                if (CGRectGetMinX(rects[j]) <= edges[i - 1] &&
+                    CGRectGetMaxX(rects[j]) >= edges[i] &&
+                    CGRectGetMinY(rects[j]) <= y && CGRectGetMaxY(rects[j]) > next)
+                    next = CGRectGetMaxY(rects[j]);
+            if (next == y) return NO;
+            y = next;
+        }
+    }
+    return YES;
+}
+
+/* Verify and refine the pan translation against actual CAD pixels. The mouse
+ * message position alone does not account for AD17's drag threshold, pixel
+ * rounding or coalesced input. Sample high-contrast edges throughout the image
+ * so a mostly blank sheet cannot make a wrong translation appear valid. */
+static BOOL register_images(CGImageRef previous, CGImageRef current, CGPoint guess, CGPoint *shift)
+{
+    struct { int x, y, axes; unsigned char rgb[9]; } samples[512];
+    CFDataRef old_data = CGDataProviderCopyData(CGImageGetDataProvider(previous));
+    CFDataRef new_data = CGDataProviderCopyData(CGImageGetDataProvider(current));
+    const unsigned char *old_bits, *new_bits, *a, *b;
+    int width = CGImageGetWidth(previous), height = CGImageGetHeight(previous);
+    size_t old_row = CGImageGetBytesPerRow(previous), new_row = CGImageGetBytesPerRow(current);
+    int count = 0, seen = 0, x, y, c, dx, dy, radius, i, checked, matches;
+    int plausible = 0, checked_x, checked_y;
+    uint32_t seed = 170028;
+    BOOL result = NO;
+    if (!old_data || !new_data || CGImageGetWidth(current) != width || CGImageGetHeight(current) != height)
+        goto done;
+    old_bits = CFDataGetBytePtr(old_data);
+    new_bits = CFDataGetBytePtr(new_data);
+    for (y = 4; y < height - 4; y += 24)
+        for (x = 4; x < width - 4; x += 24)
+        {
+            int contrast = 0, slot;
+            a = old_bits + y * old_row + x * 4;
+            for (c = 0; c < 3; ++c)
+                {
+                    if (abs(a[c] - a[c + 4]) >= 32) contrast |= 1;
+                    if (abs(a[c] - a[c + old_row]) >= 32) contrast |= 2;
+                }
+            if (!contrast) continue;
+            ++seen;
+            if (count < 512) slot = count++;
+            else { seed = seed * 1664525 + 1013904223; slot = seed % seen; if (slot >= 512) continue; }
+            samples[slot].x = x; samples[slot].y = y; samples[slot].axes = contrast;
+            memcpy(samples[slot].rgb, a, 3);
+            memcpy(samples[slot].rgb + 3, a + 4, 3);
+            memcpy(samples[slot].rgb + 6, a + old_row, 3);
+        }
+    if (count < 48) goto done;
+    for (radius = 0; radius <= 8; ++radius)
+      for (dy = (int)lround(guess.y) - radius; dy <= (int)lround(guess.y) + radius; ++dy)
+        for (dx = (int)lround(guess.x) - radius; dx <= (int)lround(guess.x) + radius; ++dx)
+        {
+            if (abs(dx - (int)lround(guess.x)) != radius && abs(dy - (int)lround(guess.y)) != radius) continue;
+            checked = matches = checked_x = checked_y = 0;
+            for (i = 0; i < count; ++i)
+            {
+                x = samples[i].x + dx; y = samples[i].y + dy;
+                if (x < 0 || x >= width - 1 || y < 0 || y >= height - 1) continue;
+                b = new_bits + y * new_row + x * 4;
+                ++checked;
+                if (samples[i].axes & 1) ++checked_x;
+                if (samples[i].axes & 2) ++checked_y;
+                /* Include the edge itself, not only its white neighboring
+                 * pixel. Otherwise a wrong shift into blank space can match. */
+                for (c = 0; c < 9; ++c)
+                {
+                    size_t offset = c < 3 ? c : c < 6 ? c + 1 : new_row + c - 6;
+                    if (abs(samples[i].rgb[c] - b[offset]) > 8) break;
+                }
+                if (c == 9) ++matches;
+                if (checked >= 32 && matches * 100 < checked * 60) break;
+            }
+            if (checked >= 48 && checked_x >= 24 && checked_y >= 24 && matches * 100 >= checked * 96)
+            {
+                if (++plausible > 1) goto done;
+                *shift = CGPointMake(dx, dy);
+            }
+        }
+    result = plausible == 1;
+done:
+    if (old_data) CFRelease(old_data);
+    if (new_data) CFRelease(new_data);
+    return result;
+}
+
+static void reset_history(void)
+{
+    while (history_count) [history[--history_count].layer removeFromSuperlayer];
+    [preview_image removeAnimationForKey:@"altium-pan-position"];
+    preview_clip.hidden = YES;
+    frame_anchor = CGPointZero;
+}
+
+static void cache_image(CGImageRef image, double scale)
+{
+    unsigned int i;
+    CALayer *layer;
+    if (history_count == PAN_HISTORY)
+    {
+        [history[0].layer removeFromSuperlayer];
+        memmove(history, history + 1, sizeof(history[0]) * (--history_count));
+    }
+    layer = [CALayer layer];
+    layer.anchorPoint = CGPointZero;
+    layer.bounds = preview_image.bounds;
+    layer.contentsScale = scale;
+    layer.contentsGravity = kCAGravityResize;
+    layer.contents = (id)image;
+    /* Integer texels keep the CAD drawing crisp even at fractional positions. */
+    layer.minificationFilter = layer.magnificationFilter = kCAFilterNearest;
+    history[history_count].layer = layer;
+    history[history_count++].anchor = frame_anchor;
+    [preview_image addSublayer:layer];
+    for (i = 0; i < history_count; ++i)
+        history[i].layer.position = CGPointMake(frame_anchor.x - history[i].anchor.x,
+                                               history[i].anchor.y - frame_anchor.y);
+}
+
+static void move_preview(CGPoint from)
+{
+    /* Never predict beyond the latest complete CAD drawing. A frame of latency
+     * buys actual pixels for newly exposed strips; mouse events still go to CAD
+     * unchanged. If the entire swept viewport is not covered, show its ordinary
+     * complete frame instead of transparent strips or invented edge pixels. */
+    CGPoint target = CGPointZero;
+    CGRect a = preview_image.bounds, b = a;
+    CABasicAnimation *animation;
+    a.origin.x -= from.x;
+    a.origin.y -= from.y;
+    [CATransaction begin];
+    [CATransaction setDisableActions:YES];
+    [preview_image removeAnimationForKey:@"altium-pan-position"];
+    preview_image.position = target;
+    preview_clip.hidden = !cached_rectangle(CGRectUnion(a, b));
+    if (from.x || from.y)
+    {
+        if (preview_clip.hidden)
+        {
+            ++pan_uncached;
+            if (fabs(from.x) > 4 && fabs(from.y) > 4) ++unsafe_transitions; else unsafe_transitions = 0;
+        }
+        else { ++pan_smoothed; unsafe_transitions = 0; }
+    }
+    if (!preview_clip.hidden)
+    {
+        animation = [CABasicAnimation animationWithKeyPath:@"position"];
+        animation.fromValue = [NSValue valueWithPoint:from];
+        animation.toValue = [NSValue valueWithPoint:target];
+        /* Follow actual CAD cadence; short fixed animations pause when a
+         * drawing takes longer than 33 ms. Coverage is verified for the entire
+         * longer sweep, and the delay stays bounded to 50 ms. */
+        animation.duration = MIN(.050, MAX(1.0 / 60.0, frame_period * 1.20));
+        animation.timingFunction = [CAMediaTimingFunction functionWithName:kCAMediaTimingFunctionLinear];
+        [preview_image addAnimation:animation forKey:@"altium-pan-position"];
+    }
+    [CATransaction commit];
+}
