+void macdrv_altium_pan_event(id object)
+{
+    NSEvent *event = object;
+    NSEventType type = event.type;
+    const NSUInteger modifiers = NSEventModifierFlagShift | NSEventModifierFlagControl |
+                                 NSEventModifierFlagOption | NSEventModifierFlagCommand;
+    uint64_t current_generation;
+
+    if (!enabled()) return;
+    if (event.modifierFlags & modifiers)
+    {
+        if (preview_view) clear_preview();
+        return;
+    }
+    if (type == NSEventTypeRightMouseDown) begin_preview(event);
+    else if (type == NSEventTypeRightMouseDragged && preview_view)
+    {
+        if (event.window != preview_view.window) { clear_preview(); return; }
+        pointer = CGEventGetLocation(event.CGEvent);
+        /* The next completed CAD drawing drives interpolation. Advancing past
+         * that drawing would expose content which has never been rendered. */
+    }
+    else if (type == NSEventTypeRightMouseUp && preview_view)
+    {
+        /* Wait for the final queued CAD drawing, bounded if no new frame is
+         * necessary. A click/key/zoom cancels immediately before editing. */
+        pointer = CGEventGetLocation(event.CGEvent);
+        if (fabs(preview_frame.anchor.x / preview_view.layer.contentsScale - pointer.x) <= 1 &&
+            fabs(preview_frame.anchor.y / preview_view.layer.contentsScale - pointer.y) <= 1)
+        {
+            clear_preview();
+            return;
+        }
+        finishing = YES;
+        finish_sequence = preview_frame.sequence;
+        current_generation = generation;
+        dispatch_after(dispatch_time(DISPATCH_TIME_NOW, 250000000), dispatch_get_main_queue(), ^{
+            if (finishing && generation == current_generation) clear_preview();
+        });
+    }
+    else if (preview_view && (type == NSEventTypeKeyDown || type == NSEventTypeScrollWheel ||
+                             type == NSEventTypeLeftMouseDown || type == NSEventTypeOtherMouseDown ||
+                             (type == NSEventTypeMouseMoved && !([NSEvent pressedMouseButtons] & 2))))
+        clear_preview();
+}
