+/* Only the verified 11.16 copy hook supplies these records. The surface's
+ * actual pixel pointer must match before a record can reach its Cocoa view.
+ * No Altium input is suppressed, synthesized, or delayed. */
+static pthread_mutex_t frame_mutex = PTHREAD_MUTEX_INITIALIZER;
+static struct
+{
+    const void *bits;
+    CGImageRef image;
+    struct macdrv_altium_pan_frame frame;
+} frames[8];
+static uint64_t next_frame;
+static char frame_key;
+static CALayer *preview_clip, *preview_image;
+/* Keep a short gesture-local history. Older drawings supply genuine pixels
+ * at the edges; never reuse them after editing, zooming or releasing. */
+#define PAN_HISTORY 3
+static struct { CALayer *layer; CGPoint anchor; } history[PAN_HISTORY];
+static unsigned int history_count;
+static NSView *preview_view;
+static struct macdrv_altium_pan_frame preview_frame;
+static CGPoint frame_anchor, pointer;
+static BOOL finishing;
+static double frame_time, frame_period;
+static unsigned int unsafe_transitions;
+static unsigned int pan_draws, pan_aligned, pan_smoothed, pan_uncached, pan_missing, pan_reset;
+static int preview_active;
+int macdrv_altium_pan_preview_active(void)
+{
+    return __atomic_load_n(&preview_active, __ATOMIC_ACQUIRE);
+}
+static uint64_t finish_sequence, generation;
+
+static pthread_once_t enabled_once = PTHREAD_ONCE_INIT;
+static BOOL pan_enabled;
+static void initialize_enabled(void)
+{
+    const char *value = getenv("ALTIUM_SMOOTH_SCHEMATIC_PAN");
+    pan_enabled = value && !strcmp(value, "1");
+}
+static BOOL enabled(void)
+{
+    pthread_once(&enabled_once, initialize_enabled);
+    return pan_enabled;
+}
+
+void macdrv_altium_pan_note_copy(const void *bits, int stride, CGRect viewport, CGPoint anchor)
+{
+    unsigned int i, slot = 0;
+    CGImageRef image = NULL;
+    /* Take the snapshot at the completed GDI copy, before its caller can start
+     * drawing another frame. Cocoa's live surface can already contain parts of
+     * the next drawing when its asynchronous presentation runs. */
+    if (macdrv_altium_pan_preview_active())
+    {
+        int width = viewport.size.width, height = viewport.size.height, y;
+        size_t row = (size_t)width * 4;
+        unsigned char *pixels = malloc(row * height);
+        if (pixels)
+        {
+            CGDataProviderRef provider;
+            CGColorSpaceRef space;
+            CFDataRef data;
+            const unsigned char *src = (const unsigned char *)bits +
+                (int)viewport.origin.y * (ptrdiff_t)stride + (int)viewport.origin.x * 4;
+            for (y = 0; y < height; ++y) memcpy(pixels + y * row, src + y * (ptrdiff_t)stride, row);
+            data = CFDataCreateWithBytesNoCopy(kCFAllocatorDefault, pixels, row * height, kCFAllocatorMalloc);
+            provider = data ? CGDataProviderCreateWithCFData(data) : NULL;
+            if (data) CFRelease(data);
+            else free(pixels);
+            if (provider)
+            {
+                space = CGColorSpaceCreateWithName(kCGColorSpaceSRGB);
+                image = CGImageCreate(width, height, 8, 32, row, space,
+                    kCGImageAlphaNoneSkipFirst | kCGBitmapByteOrder32Little,
+                    provider, NULL, FALSE, kCGRenderingIntentDefault);
+                CGColorSpaceRelease(space);
+                CGDataProviderRelease(provider);
+            }
+        }
+    }
+    pthread_mutex_lock(&frame_mutex);
+    for (i = 0; i < 8; ++i)
+    {
+        if (frames[i].bits == bits) { slot = i; break; }
+        if (frames[i].frame.sequence < frames[slot].frame.sequence) slot = i;
+    }
+    if (!macdrv_altium_pan_preview_active()) { CGImageRelease(image); image = NULL; }
+    CGImageRelease(frames[slot].image);
+    frames[slot].image = image;
+    frames[slot].bits = bits;
+    frames[slot].frame.viewport = viewport;
+    frames[slot].frame.anchor = anchor;
+    frames[slot].frame.sequence = ++next_frame;
+    pthread_mutex_unlock(&frame_mutex);
+}
+
+static CGImageRef copy_frame(uint64_t sequence)
+{
+    CGImageRef image = NULL;
+    unsigned int i;
+    pthread_mutex_lock(&frame_mutex);
+    for (i = 0; i < 8; ++i)
+        if (frames[i].frame.sequence == sequence) { image = CGImageRetain(frames[i].image); break; }
+    pthread_mutex_unlock(&frame_mutex);
+    return image;
+}
+
+void macdrv_altium_pan_get_frame(const void *bits, struct macdrv_altium_pan_frame *frame)
+{
+    unsigned int i;
+    memset(frame, 0, sizeof(*frame));
+    if (!enabled()) return;
+    pthread_mutex_lock(&frame_mutex);
+    for (i = 0; i < 8; ++i)
+        if (frames[i].bits == bits) { *frame = frames[i].frame; break; }
+    pthread_mutex_unlock(&frame_mutex);
+}
+
+static void clear_preview(void)
+{
+    unsigned int i;
+    const char *stats = getenv("ALTIUM_PAN_STATS");
+    if (preview_view && stats && !strcmp(stats, "1"))
+        fprintf(stderr, "ALTIUM_PAN: frames=%u aligned=%u smooth=%u raw=%u missing=%u reset=%u\n",
+                pan_draws, pan_aligned, pan_smoothed, pan_uncached, pan_missing, pan_reset);
+    [preview_clip removeFromSuperlayer];
+    [preview_clip release];
+    preview_clip = preview_image = nil;
+    preview_view = nil;
+    history_count = 0;
+    finishing = NO;
+    ++generation;
+    __atomic_store_n(&preview_active, 0, __ATOMIC_RELEASE);
+    pthread_mutex_lock(&frame_mutex);
+    for (i = 0; i < 8; ++i) { CGImageRelease(frames[i].image); frames[i].image = NULL; }
+    pthread_mutex_unlock(&frame_mutex);
+}
+
+void macdrv_altium_pan_cancel_view(id view)
+{
+    if (preview_view == view) clear_preview();
+}
+
+void macdrv_altium_pan_set_frame(id view, const struct macdrv_altium_pan_frame *frame)
+{
+    if (!enabled() || !frame->sequence) return;
+    objc_setAssociatedObject(view, &frame_key,
+        [NSValue valueWithBytes:frame objCType:@encode(struct macdrv_altium_pan_frame)],
+        OBJC_ASSOCIATION_RETAIN_NONATOMIC);
+}
+
+static BOOL view_frame(NSView *view, struct macdrv_altium_pan_frame *frame)
+{
+    NSValue *value = objc_getAssociatedObject(view, &frame_key);
+    if (!value) return NO;
+    [value getValue:frame];
+    return frame->sequence != 0;
+}
+
+static BOOL can_preview(NSWindow *window)
+{
+    return [window isKindOfClass:[WineWindow class]] && ![(WineWindow *)window disabled] &&
+           ![(WineWindow *)window noForeground] && [window isVisible] && ![window isMiniaturized] &&
+           [window.title.lowercaseString containsString:@".schdoc"];
+}
