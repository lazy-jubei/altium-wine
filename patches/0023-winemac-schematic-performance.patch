+static void begin_preview(NSEvent *event)
+{
+    NSWindow *window = event.window;
+    NSView *view = window.contentView;
+    CALayer *root = view.layer;
+    struct macdrv_altium_pan_frame frame;
+    CGRect viewport;
+    CGPoint local;
+    double scale;
+
+    clear_preview();
+    if (!can_preview(window) ||
+        !view_frame(view, &frame) || !root.contents || root.bounds.size.width < 600) return;
+    scale = root.contentsScale;
+    if (scale <= 0) return;
+    viewport = CGRectMake(frame.viewport.origin.x / scale, frame.viewport.origin.y / scale,
+                          frame.viewport.size.width / scale, frame.viewport.size.height / scale);
+    local = [view convertPoint:event.locationInWindow fromView:nil];
+    if (!CGRectContainsPoint(viewport, local) || !CGRectContainsRect(root.bounds, viewport)) return;
+    unsafe_transitions = 0;
+    frame_time = 0;
+    frame_period = 1.0 / 30.0;
+    pan_draws = pan_aligned = pan_smoothed = pan_uncached = pan_missing = pan_reset = 0;
+    __atomic_store_n(&preview_active, 1, __ATOMIC_RELEASE);
+    preview_view = view;
+    preview_frame = frame;
+    pointer = CGEventGetLocation(event.CGEvent);
+    frame_anchor = CGPointZero;
+    preview_clip = [[CALayer layer] retain];
+    preview_clip.geometryFlipped = root.geometryFlipped;
+    preview_clip.frame = viewport;
+    preview_clip.masksToBounds = YES;
+    /* Only display the cache when it covers the whole swept viewport. */
+    preview_clip.hidden = YES;
+    preview_image = [CALayer layer];
+    preview_image.anchorPoint = CGPointZero;
+    preview_image.bounds = CGRectMake(0, 0, viewport.size.width, viewport.size.height);
+    preview_image.position = CGPointZero;
+    [CATransaction begin];
+    [CATransaction setDisableActions:YES];
+    [preview_clip addSublayer:preview_image];
+    [root addSublayer:preview_clip];
+    [CATransaction commit];
+}
