+/* These private interfaces are accepted only for the verified Gcenx 11.16
+ * win32u UUID below. Replacing that module disables the optimization. This
+ * preserves the stock module's FreeType, Vulkan and Staging implementation. */
+struct altium_rect { int32_t left, top, right, bottom; };
+struct altium_point { int32_t x, y; };
+struct altium_dib
+{
+    int32_t bit_count, width, height, compression;
+    struct altium_rect rect;
+    int32_t stride;
+    void *bits;
+};
+_Static_assert(offsetof(struct altium_dib, bits) == 0x28, "Wine 11.16 dib_info ABI");
+
+typedef void (*altium_copy_func)(const struct altium_dib *, const struct altium_rect *,
+                                const struct altium_dib *, const struct altium_point *, int, int);
+static altium_copy_func original_copy, *copy_table1, *copy_table2;
+static int copy_workers = 2, parallel_enabled, pan_enabled, native_enabled, native_workers=2;
+static uint32_t (*message_pos)(void);
+
+struct altium_copy_work
+{
+    uint8_t *src, *dst;
+    int src_stride, dst_stride, width, height, tasks, reverse;
+};
+
+static uint8_t *altium_pixel(const struct altium_dib *dib, int x, int y)
+{
+    return (uint8_t *)dib->bits + ((int64_t)y + dib->rect.top) * dib->stride +
+           ((int64_t)x + dib->rect.left) * 4;
+}
+
+static void altium_copy_rows(void *context, size_t task)
+{
+    struct altium_copy_work *w = context;
+    int y, first = w->height * task / w->tasks, last = w->height * (task + 1) / w->tasks;
+    for (y = first; y < last; y++)
+        memmove(w->dst + (int64_t)y * w->dst_stride, w->src + (int64_t)y * w->src_stride,
+                (size_t)w->width * 4);
+}
+
+static void altium_copy_columns(void *context, size_t task)
+{
+    struct altium_copy_work *w = context;
+    int n, blocks = (w->width + 15) / 16;
+    int first = (blocks * task / w->tasks) * 16, last = (blocks * (task + 1) / w->tasks) * 16;
+    if (last > w->width) last = w->width;
+    if (first >= last) return;
+    for (n = 0; n < w->height; n++)
+    {
+        int y = w->reverse ? w->height - 1 - n : n;
+        memmove(w->dst + (int64_t)y * w->dst_stride + first * 4,
+                w->src + (int64_t)y * w->src_stride + first * 4, (size_t)(last - first) * 4);
+    }
+}
+
+static void altium_parallel_copy(const struct altium_dib *dst, const struct altium_rect *rc,
+                                 const struct altium_dib *src, const struct altium_point *origin,
+                                 int rop, int overlap)
+{
+    int width = rc->right - rc->left, height = rc->bottom - rc->top;
+    int independent, vertical;
+    int present = (pan_enabled || native_enabled) && rop == 13 &&
+                  src->bit_count == 32 && dst->bit_count == 32 &&
+                  src->bits != dst->bits && src->stride != dst->stride &&
+                  width > 1000 && height > 500 && width == src->width && height == src->height &&
+                  !origin->x && !origin->y && !rc->left && !rc->top &&
+                  !src->rect.left && !src->rect.top && dst->rect.left >= 0 && dst->rect.top >= 0 &&
+                  dst->rect.left + width <= dst->width && dst->rect.top + height <= dst->height;
+    uint32_t position = present && pan_enabled && message_pos ? message_pos() : 0;
+    int64_t sd, dd;
+    uintptr_t slo, shi, dlo, dhi;
+    uint8_t *s, *d;
+    struct altium_copy_work work;
+
+    /* Only a complete, non-overlapping viewport transfer is delegated. The
+     * worker writes the existing destination pixels and confirms completion
+     * before GDI returns; failed startup or IPC falls back to Wine. Active
+     * pan previews retain the ordinary copy path to avoid competing updates. */
+    if (native_enabled && present && !macdrv_altium_pan_preview_active() && src->stride > 0 && dst->stride > 0)
+    {
+        uint8_t *nsrc=altium_pixel(src,origin->x,origin->y), *ndst=altium_pixel(dst,rc->left,rc->top);
+        uintptr_t se=(uintptr_t)nsrc+(uint64_t)(height-1)*src->stride+(uint64_t)width*4;
+        uintptr_t de=(uintptr_t)ndst+(uint64_t)(height-1)*dst->stride+(uint64_t)width*4;
+        if ((se<=(uintptr_t)ndst || de<=(uintptr_t)nsrc) &&
+            arm_copy(ndst,nsrc,dst->stride,src->stride,width,height,0,native_workers,NULL)) goto complete;
+    }
+
+    /* Keep small copies and every other raster operation on Wine's path. */
+    if (!parallel_enabled || rop != 13 || src->bit_count != 32 || dst->bit_count != 32 || width < 128 || height < 128 ||
+        (uint64_t)width * height < 524288 || (uint64_t)width * height > 67108864)
+        goto fallback;
+
+    s = altium_pixel(src, origin->x, origin->y);
+    d = altium_pixel(dst, rc->left, rc->top);
+    sd = (int64_t)(height - 1) * src->stride;
+    dd = (int64_t)(height - 1) * dst->stride;
+    slo = (uintptr_t)s + (sd < 0 ? sd : 0); shi = (uintptr_t)s + (sd > 0 ? sd : 0) + (size_t)width * 4;
+    dlo = (uintptr_t)d + (dd < 0 ? dd : 0); dhi = (uintptr_t)d + (dd > 0 ? dd : 0) + (size_t)width * 4;
+    independent = !(slo < dhi && dlo < shi);
+
+    /* Horizontal scrolling can split into rows only when rows cannot alias.
+     * The memmove within each row retains the horizontal dependency order. */
+    if (!independent && src->bits == dst->bits && src->stride == dst->stride &&
+        origin->y + src->rect.top == rc->top + dst->rect.top &&
+        llabs((long long)src->stride) >= (int64_t)width * 4 + llabs((int64_t)s - (int64_t)d))
+        independent = 1;
+
+    /* Pure vertical scrolling splits into columns. Each column traverses rows
+     * in Wine's overlap order, with no cross-column source dependency. Diagonal
+     * overlaps remain entirely on the original path. */
+    vertical = src->bits == dst->bits && src->stride == dst->stride &&
+               rc->left + dst->rect.left == origin->x + src->rect.left &&
+               llabs((long long)src->stride) >= (int64_t)width * 4;
+    if (!independent && !vertical) goto fallback;
+
+    work = (struct altium_copy_work){s, d, src->stride, dst->stride, width, height,
+                                     copy_workers, !!(overlap & 8)};
+    /* Synchronous completion preserves GDI's caller-visible pixel ordering. */
+    dispatch_apply_f(work.tasks, dispatch_get_global_queue(QOS_CLASS_USER_INTERACTIVE, 0),
+                     &work, independent ? altium_copy_rows : altium_copy_columns);
+    goto complete;
+
+fallback:
+    original_copy(dst, rc, src, origin, rop, overlap);
+complete:
+    if (present && pan_enabled && message_pos)
+        macdrv_altium_pan_note_copy(dst->bits, dst->stride,
+            CGRectMake(dst->rect.left, dst->rect.top, width, height),
+            CGPointMake((int16_t)position, (int16_t)(position >> 16)));
+}
+
+static int altium_hook_image(const struct mach_header *header, intptr_t slide)
+{
+    const uint8_t expected_uuid[16] = {0x4e,0xe2,0xce,0x2b,0x55,0xa5,0x39,0x87,
+                                       0x96,0xc2,0x50,0xc8,0x05,0x59,0xb3,0x37};
+    const uint8_t prologue[] = {0x55,0x48,0x89,0xe5,0x41,0x57,0x41,0x56,
+                                0x41,0x55,0x41,0x54,0x53,0x48,0x83,0xec,0x48};
+    const struct load_command *lc;
+    uint32_t i;
+    uintptr_t code, page_address;
+    size_t page;
+    int matches = 0;
+    altium_copy_func *table1, *table2;
+
+    if (header->magic != MH_MAGIC_64) return 0;
+    lc = (const void *)((const struct mach_header_64 *)header + 1);
+    for (i = 0; i < header->ncmds; i++)
+    {
+        if (lc->cmd == LC_UUID && lc->cmdsize >= sizeof(struct uuid_command) &&
+            !memcmp(((const struct uuid_command *)lc)->uuid, expected_uuid, sizeof(expected_uuid)))
+            matches = 1;
+        lc = (const void *)((const char *)lc + lc->cmdsize);
+    }
+    if (!matches) return 0;
+
+    code = slide + 0x348c0;
+    table1 = (void *)(slide + 0x1cc778); table2 = (void *)(slide + 0x1cc808);
+    if (memcmp((void *)code, prologue, sizeof(prologue)) ||
+        (uintptr_t)*table1 != code || (uintptr_t)*table2 != code) return 0;
+    page = getpagesize(); page_address = (uintptr_t)table1 & ~(uintptr_t)(page - 1);
+    if (((uintptr_t)table2 & ~(uintptr_t)(page - 1)) != page_address) return 0;
+    if (mach_vm_protect(mach_task_self(), page_address, page, 0,
+                         VM_PROT_READ | VM_PROT_WRITE | VM_PROT_COPY) != KERN_SUCCESS) return 0;
+
+    original_copy = (altium_copy_func)code;
+    copy_table1 = table1; copy_table2 = table2;
+    *table1 = altium_parallel_copy; *table2 = altium_parallel_copy;
+    mach_vm_protect(mach_task_self(), page_address, page, 0, VM_PROT_READ);
+    return 1;
+}
+
+__attribute__((constructor)) static void altium_gdi_start(void)
+{
+    const char *enabled = getenv("ALTIUM_PARALLEL_GDI"), *workers;
+    const char *pan = getenv("ALTIUM_SMOOTH_SCHEMATIC_PAN");
+    uint32_t i;
+    parallel_enabled = enabled && !strcmp(enabled, "1");
+    pan_enabled = pan && !strcmp(pan, "1");
+    enabled=getenv("ALTIUM_NATIVE_GDI");native_enabled=enabled&&!strcmp(enabled,"1");
+    if(native_enabled){
+        Dl_info info;char *slash;
+        if(dladdr((void*)altium_gdi_start,&info)&&info.dli_fname&&strlen(info.dli_fname)<sizeof(native_worker_path)-50){
+            strcpy(native_worker_path,info.dli_fname);slash=strrchr(native_worker_path,'/');
+            if(slash)strcpy(slash,"/../../../bin/altium-gdi-copy-arm64");
+        }
+        workers=getenv("ALTIUM_NATIVE_GDI_WORKERS");
+        if(workers&&atoi(workers)>=1&&atoi(workers)<=4)native_workers=atoi(workers);
+    }
+    if (!parallel_enabled && !pan_enabled && !native_enabled) return;
+    message_pos = dlsym(RTLD_DEFAULT, "NtUserGetMessagePos");
+    workers = getenv("ALTIUM_GDI_WORKERS");
+    if (workers && atoi(workers) >= 1 && atoi(workers) <= 8) copy_workers = atoi(workers);
+    /* win32u is already loaded as this driver's native dependency. Avoid a
+     * permanent dyld callback into a driver that might later be unloaded. */
+    for (i = 0; i < _dyld_image_count(); i++)
+        if (altium_hook_image(_dyld_get_image_header(i), _dyld_get_image_vmaddr_slide(i)))
+        {
+            fprintf(stderr, "ALTIUM_GDI: parallel=%d (%d workers), schematic preview=%d, native viewport=%d\n",
+                    parallel_enabled, copy_workers, pan_enabled && !!message_pos,native_enabled);
+            return;
+        }
+    fprintf(stderr, "ALTIUM_GDI: unrecognized win32u; using ordinary copies\n");
+}
+
+__attribute__((destructor)) static void altium_gdi_stop(void)
+{
+    size_t page;
+    uintptr_t address;
+    altium_native_shutdown();
+    if (!original_copy) return;
+    page = getpagesize(); address = (uintptr_t)copy_table1 & ~(uintptr_t)(page - 1);
+    if (mach_vm_protect(mach_task_self(), address, page, 0,
+                         VM_PROT_READ | VM_PROT_WRITE | VM_PROT_COPY) != KERN_SUCCESS) return;
+    if (*copy_table1 == altium_parallel_copy) *copy_table1 = original_copy;
+    if (*copy_table2 == altium_parallel_copy) *copy_table2 = original_copy;
+    mach_vm_protect(mach_task_self(), address, page, 0, VM_PROT_READ);
+}
