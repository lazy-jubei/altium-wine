+        BATCH_ELEMENT("COLOR", color, DXGI_FORMAT_R32G32B32A32_FLOAT),
+        BATCH_ELEMENT("KIND", kind, DXGI_FORMAT_R32_UINT), BATCH_ELEMENT("WIDTH", width, DXGI_FORMAT_R32_FLOAT),
+        BATCH_ELEMENT("CANVAS", canvas, DXGI_FORMAT_R32G32B32_FLOAT)
+#undef BATCH_ELEMENT
+    };
+    ID3DBlob *code = NULL, *errors = NULL;
+    HRESULT hr;
+    char value[8];
+    if (batch->ready)
+        return TRUE;
+    if (batch->failed)
+        return FALSE;
+    hr = D3DCompile(
+            d2d_batch_vs, sizeof(d2d_batch_vs) - 1, "d2d_batch_vs", NULL, NULL, "main", "vs_4_0", 0, 0, &code, &errors);
+    if (FAILED(hr))
+        goto failed;
+    if (errors)
+    {
+        ID3D10Blob_Release(errors);
+        errors = NULL;
+    }
+    hr = ID3D11Device1_CreateVertexShader(context->d3d_device, ID3D10Blob_GetBufferPointer(code),
+            ID3D10Blob_GetBufferSize(code), NULL, &batch->shaders.vs);
+    if (SUCCEEDED(hr))
+        hr = ID3D11Device1_CreateInputLayout(context->d3d_device, input, ARRAY_SIZE(input),
+                ID3D10Blob_GetBufferPointer(code), ID3D10Blob_GetBufferSize(code), &batch->shaders.il);
+    ID3D10Blob_Release(code);
+    code = NULL;
+    if (FAILED(hr))
+        goto failed;
+    hr = D3DCompile(
+            d2d_batch_ps, sizeof(d2d_batch_ps) - 1, "d2d_batch_ps", NULL, NULL, "main", "ps_4_0", 0, 0, &code, &errors);
+    if (FAILED(hr))
+        goto failed;
+    hr = ID3D11Device1_CreatePixelShader(
+            context->d3d_device, ID3D10Blob_GetBufferPointer(code), ID3D10Blob_GetBufferSize(code), NULL, &batch->ps);
+    ID3D10Blob_Release(code);
+    code = NULL;
+    if (FAILED(hr))
+        goto failed;
+    if (errors)
+        ID3D10Blob_Release(errors);
+    batch->ready = TRUE;
+    if (GetEnvironmentVariableA("WINE_D2D_BATCH_STATS", value, sizeof(value)) && value[0] == '1')
+        fprintf(stderr, "D2D_BATCH pipeline ready\n");
+    return TRUE;
+failed:
+    WARN("Batch shader initialization failed, hr %#lx.\n", hr);
+    if (errors)
+    {
+        WARN("Batch shader error: %s\n", (char *)ID3D10Blob_GetBufferPointer(errors));
+        ID3D10Blob_Release(errors);
+    }
+    if (code)
+        ID3D10Blob_Release(code);
+    batch->failed = TRUE;
+    return FALSE;
+}
+
+static void d2d_batch_flush_locked(struct d2d_device_context *context)
+{
+    struct d2d_solid_batch *batch = context->solid_batch;
+    D2D1_MATRIX_3X2_F saved_transform;
+    struct d2d_shape_resources saved_shaders;
+    ID3D11PixelShader *saved_ps;
+    ID3D11DeviceContext *d3d_context;
+    D3D11_BUFFER_DESC desc = { 0 };
+    D3D11_MAPPED_SUBRESOURCE map;
+    float dpi_x, dpi_y;
+    HRESULT hr;
+    struct d2d_brush brush = { 0 };
+    if (!batch || batch->flushing || !batch->count)
+        return;
+    batch->flushing = TRUE;
+    ID3D11Device1_GetImmediateContext(context->d3d_device, &d3d_context);
+    if (batch->gpu_capacity < batch->count)
+    {
+        if (batch->buffer)
+            ID3D11Buffer_Release(batch->buffer);
+        batch->buffer = NULL;
+        batch->gpu_capacity = 0;
+        desc.ByteWidth = batch->capacity * sizeof(*batch->vertices);
+        desc.Usage = D3D11_USAGE_DYNAMIC;
+        desc.BindFlags = D3D11_BIND_VERTEX_BUFFER;
+        desc.CPUAccessFlags = D3D11_CPU_ACCESS_WRITE;
+        hr = ID3D11Device1_CreateBuffer(context->d3d_device, &desc, NULL, &batch->buffer);
+        if (FAILED(hr))
+            goto done;
+        batch->gpu_capacity = batch->capacity;
+    }
+    hr = ID3D11DeviceContext_Map(d3d_context, (ID3D11Resource *)batch->buffer, 0, D3D11_MAP_WRITE_DISCARD, 0, &map);
+    if (FAILED(hr))
+        goto done;
+    memcpy(map.pData, batch->vertices, batch->count * sizeof(*batch->vertices));
+    ID3D11DeviceContext_Unmap(d3d_context, (ID3D11Resource *)batch->buffer, 0);
+    saved_transform = context->drawing_state.transform;
+    dpi_x = context->desc.dpiX;
+    dpi_y = context->desc.dpiY;
+    context->drawing_state.transform = identity;
+    context->desc.dpiX = context->desc.dpiY = 96.0f;
+    hr = d2d_device_context_update_vs_cb(context, &identity, 0.0f);
+    if (SUCCEEDED(hr))
+    {
+        saved_shaders = context->shape_resources[D2D_SHAPE_TYPE_TRIANGLE];
+        saved_ps = context->ps;
+        context->shape_resources[D2D_SHAPE_TYPE_TRIANGLE] = batch->shaders;
+        context->ps = batch->ps;
+        brush.type = D2D_BRUSH_TYPE_SOLID;
+        d2d_device_context_draw(context, D2D_SHAPE_TYPE_TRIANGLE, NULL, batch->count, batch->buffer,
+                sizeof(*batch->vertices), &brush, NULL);
+        context->shape_resources[D2D_SHAPE_TYPE_TRIANGLE] = saved_shaders;
+        context->ps = saved_ps;
+    }
+    context->drawing_state.transform = saved_transform;
+    context->desc.dpiX = dpi_x;
+    context->desc.dpiY = dpi_y;
+done:
+    if (FAILED(hr))
+        d2d_device_context_set_error(context, hr);
+    ID3D11DeviceContext_Release(d3d_context);
+    batch->count = 0;
+    batch->flushing = FALSE;
+}
+
+static void d2d_solid_batch_flush(struct d2d_device_context *context)
+{
+    if (context->cs)
+        EnterCriticalSection(context->cs);
+    d2d_batch_flush_locked(context);
+    if (context->cs)
+        LeaveCriticalSection(context->cs);
+}
+
+static void d2d_solid_batch_free(struct d2d_device_context *context)
+{
+    struct d2d_solid_batch *batch = context->solid_batch;
+    if (!batch)
+        return;
+    d2d_solid_batch_flush(context);
+    free(batch->vertices);
+    if (batch->buffer)
+        ID3D11Buffer_Release(batch->buffer);
+    if (batch->ps)
+        ID3D11PixelShader_Release(batch->ps);
+    if (batch->shaders.vs)
+        ID3D11VertexShader_Release(batch->shaders.vs);
+    if (batch->shaders.il)
+        ID3D11InputLayout_Release(batch->shaders.il);
+    free(batch);
+}
+
+static D2D1_POINT_2F d2d_solid_batch_position(
+        struct d2d_device_context *context, const D2D1_MATRIX_3X2_F *g, D2D1_POINT_2F p)
+{
+    const D2D1_MATRIX_3X2_F *w = &context->drawing_state.transform;
+    D2D1_POINT_2F q = { p.x * g->_11 + p.y * g->_21 + g->_31, p.x * g->_12 + p.y * g->_22 + g->_32 };
+    p.x = (q.x * w->_11 + q.y * w->_21 + w->_31) * (context->desc.dpiX / 96.0f);
+    p.y = (q.x * w->_12 + q.y * w->_22 + w->_32) * (context->desc.dpiY / 96.0f);
+    return p;
+}
+
+static struct d2d_solid_batch *d2d_batch_reserve(
+        struct d2d_device_context *context, struct d2d_brush *brush, UINT count)
+{
+    struct d2d_solid_batch *batch;
+    struct d2d_batch_vertex *vertices;
+    UINT capacity;
+    if (!d2d_solid_batch_enabled() || !brush || brush->type != D2D_BRUSH_TYPE_SOLID
+            || context->target.type != D2D_TARGET_BITMAP || count > 65536 || !isfinite(brush->opacity)
+            || !isfinite(brush->u.solid.color.a)
+            || (context->drawing_state.primitiveBlend != D2D1_PRIMITIVE_BLEND_SOURCE_OVER
+                    && context->drawing_state.primitiveBlend != D2D1_PRIMITIVE_BLEND_COPY))
+        return NULL;
+    if (!(batch = context->solid_batch))
+        if (!(batch = context->solid_batch = calloc(1, sizeof(*batch))))
+            return NULL;
+    if (!d2d_batch_init(context, batch))
+        return NULL;
+    batch->color = brush->u.solid.color;
+    {
+        float opacity = max(0.0f, min(brush->opacity, 1.0f));
+        batch->color.r *= batch->color.a;
+        batch->color.g *= batch->color.a;
+        batch->color.b *= batch->color.a;
+        batch->color.r *= opacity;
+        batch->color.g *= opacity;
+        batch->color.b *= opacity;
+        batch->color.a *= opacity;
+    }
+    if (batch->count + count > 65536)
+        d2d_solid_batch_flush(context);
+    capacity = batch->capacity;
+    if (capacity >= batch->count + count)
+        return batch;
+    if (!capacity)
+        capacity = 512;
+    while (capacity < batch->count + count)
+        capacity *= 2;
+    if (!(vertices = realloc(batch->vertices, capacity * sizeof(*vertices))))
+        return NULL;
+    memset(vertices + batch->capacity, 0, (capacity - batch->capacity) * sizeof(*vertices));
+    batch->vertices = vertices;
+    batch->capacity = capacity;
+    return batch;
+}
+static struct d2d_batch_vertex *d2d_batch_vertex(struct d2d_solid_batch *batch, UINT kind)
+{
+    struct d2d_batch_vertex *v = &batch->vertices[batch->count++];
+    v->kind = kind;
+    v->color = batch->color;
+    v->width = 0.0f;
+    return v;
+}
+static BOOL d2d_batch_add_fill_locked(struct d2d_device_context *context, const struct d2d_geometry *geometry,
+        const D2D1_MATRIX_3X2_F *transform, struct d2d_brush *brush, struct d2d_brush *opacity)
+{
+    struct d2d_solid_batch *batch;
+    unsigned int count, i, j, k;
+    if (opacity || geometry->fill.face_count > 65536 / 3 || geometry->fill.bezier_vertex_count > 65536
+            || geometry->fill.arc_vertex_count > 65536)
+        return FALSE;
+    count = geometry->fill.face_count * 3 + geometry->fill.bezier_vertex_count + geometry->fill.arc_vertex_count;
+    if (!(batch = d2d_batch_reserve(context, brush, count)))
+        return FALSE;
+    for (i = 0; i < geometry->fill.face_count; ++i)
+        for (j = 0; j < 3; ++j)
+        {
+            struct d2d_batch_vertex *v = d2d_batch_vertex(batch, 0);
+            v->position = d2d_solid_batch_position(
+                    context, transform, geometry->fill.vertices[geometry->fill.faces[i].v[j]]);
+        }
+    for (k = 0; k < 2; ++k)
+        for (i = 0; i < (k ? geometry->fill.arc_vertex_count : geometry->fill.bezier_vertex_count); ++i)
+        {
+            const struct d2d_curve_vertex *source
+                    = k ? &geometry->fill.arc_vertices[i] : &geometry->fill.bezier_vertices[i];
+            struct d2d_batch_vertex *v = d2d_batch_vertex(batch, k + 1);
+            v->position = d2d_solid_batch_position(context, transform, source->position);
+            v->p0.x = source->texcoord.u;
+            v->p0.y = source->texcoord.v;
+            v->p1.x = source->texcoord.sign;
+        }
+    return TRUE;
+}
+static BOOL d2d_batch_add_outline_locked(
+        struct d2d_device_context *context, const struct d2d_geometry *geometry, struct d2d_brush *brush, float width)
+{
+    const D2D1_MATRIX_3X2_F *w = &context->drawing_state.transform, *g = &geometry->transform;
+    struct d2d_solid_batch *batch;
+    unsigned int count, i, j, k;
+    float scale, tx, ty;
+    if (g->_11 != 1.0f || g->_22 != 1.0f || g->_12 != 0.0f || g->_21 != 0.0f || g->_31 != 0.0f || g->_32 != 0.0f
+            || w->_12 != 0.0f || w->_21 != 0.0f || w->_11 != w->_22 || w->_11 <= 0.0f
+            || context->desc.dpiX != context->desc.dpiY || !isfinite(width) || !isfinite(w->_11)
+            || geometry->outline.face_count > 65536 / 3 || geometry->outline.bezier_face_count > 65536 / 3
+            || geometry->outline.arc_face_count > 65536 / 3)
+        return FALSE;
+    count = (geometry->outline.face_count + geometry->outline.bezier_face_count + geometry->outline.arc_face_count) * 3;
+    if (!(batch = d2d_batch_reserve(context, brush, count)))
+        return FALSE;
+    scale = w->_11 * (context->desc.dpiX / 96.0f);
+    tx = w->_31 * (context->desc.dpiX / 96.0f);
+    ty = w->_32 * (context->desc.dpiY / 96.0f);
+    for (i = 0; i < geometry->outline.face_count; ++i)
+        for (j = 0; j < 3; ++j)
+        {
+            const struct d2d_outline_vertex *source = &geometry->outline.vertices[geometry->outline.faces[i].v[j]];
+            struct d2d_batch_vertex *v = d2d_batch_vertex(batch, 3);
+            v->position = source->position;
+            v->prev = source->prev;
+            v->next = source->next;
+            v->width = width;
+            v->canvas[0] = scale;
+            v->canvas[1] = tx;
+            v->canvas[2] = ty;
+        }
+    for (k = 0; k < 2; ++k)
+        for (i = 0; i < (k ? geometry->outline.arc_face_count : geometry->outline.bezier_face_count); ++i)
+            for (j = 0; j < 3; ++j)
+            {
+                const struct d2d_face *faces = k ? geometry->outline.arc_faces : geometry->outline.bezier_faces;
+                const struct d2d_curve_outline_vertex *vertices
+                        = k ? geometry->outline.arcs : geometry->outline.beziers;
+                const struct d2d_curve_outline_vertex *source = &vertices[faces[i].v[j]];
+                struct d2d_batch_vertex *v = d2d_batch_vertex(batch, k + 4);
+                v->position = source->position;
+                v->p0 = source->p0;
+                v->p1 = source->p1;
+                v->p2 = source->p2;
+                v->prev = source->prev;
+                v->next = source->next;
+                v->width = width;
+                v->canvas[0] = scale;
+                v->canvas[1] = tx;
+                v->canvas[2] = ty;
+            }
+    return TRUE;
+}
+
+static BOOL d2d_batch_add_geometry(struct d2d_device_context *context, const struct d2d_geometry *geometry,
+        const D2D1_MATRIX_3X2_F *transform, struct d2d_brush *brush, struct d2d_brush *opacity, float width)
+{
+    BOOL ret;
+    if (context->cs)
+        EnterCriticalSection(context->cs);
+    ret = transform ? d2d_batch_add_fill_locked(context, geometry, transform, brush, opacity)
+                    : d2d_batch_add_outline_locked(context, geometry, brush, width);
+    if (context->cs)
+        LeaveCriticalSection(context->cs);
+    return ret;
 }
 
