+/* One ordered triangle stream for solid fills and strokes. Per-vertex colour,
+ * width and shape kind avoid changing constants between primitives. Strokes
+ * retain the original extrusion-before-canvas-transform arithmetic. */
+struct d2d_batch_vertex
+{
+    D2D1_POINT_2F position, p0, p1, p2, prev, next;
+    D2D1_COLOR_F color;
+    float canvas[3];
+    UINT kind;
+    float width;
+};
+struct d2d_solid_batch
+{
+    BOOL flushing, ready, failed;
+    D2D1_COLOR_F color;
+    struct d2d_batch_vertex *vertices;
+    UINT count, capacity, gpu_capacity;
+    ID3D11Buffer *buffer;
+    struct d2d_shape_resources shaders;
+    ID3D11PixelShader *ps;
+};
