+static BOOL d2d_primitive_cache_enabled(void)
+{
+    static LONG enabled = -1;
+    char value[8];
+    if (enabled == -1)
+        InterlockedExchange(&enabled,
+                GetEnvironmentVariableA("WINE_D2D_PRIMITIVE_CACHE", value, sizeof(value)) == 1 && value[0] == '1');
+    return enabled;
+}
