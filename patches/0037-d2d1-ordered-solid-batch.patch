+static BOOL d2d_cached_primitive(struct d2d_device_context *context, unsigned kind, float x, float y, float width,
+        float height, ID2D1Brush *brush, float stroke_width, ID2D1StrokeStyle *style, BOOL fill)
+{
+    BOOL ret;
+    if (context->cs)
+        EnterCriticalSection(context->cs);
+    ret = d2d_cached_primitive_locked(context, kind, x, y, width, height, brush, stroke_width, style, fill);
+    if (context->cs)
+        LeaveCriticalSection(context->cs);
+    return ret;
+}
