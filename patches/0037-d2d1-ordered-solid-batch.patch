+/* Keep canonical geometry and its immutable GPU buffers; translate only the
+ * drawing transform. Pattern brushes retain the ordinary coordinate path. */
+static BOOL d2d_cached_primitive_locked(struct d2d_device_context *context, unsigned kind, float x, float y,
+        float width, float height, ID2D1Brush *brush, float stroke_width, ID2D1StrokeStyle *style, BOOL fill)
+{
+    D2D1_MATRIX_3X2_F saved, *transform = &context->drawing_state.transform;
+    ID2D1Geometry *geometry;
+    UINT32 w, h, index, base, probe;
+    HRESULT hr;
+    struct d2d_brush *b = unsafe_impl_from_ID2D1Brush(brush);
+
+    if (!d2d_primitive_cache_enabled() || !b || b->type != D2D_BRUSH_TYPE_SOLID
+            || context->target.type == D2D_TARGET_COMMAND_LIST || !isfinite(x) || !isfinite(y) || !isfinite(width)
+            || !isfinite(height) || (kind && (width <= 0 || height <= 0)) || (!width && !height)
+        || (!kind && width && height))
+        return FALSE;
+    memcpy(&w, &width, sizeof(w));
+    memcpy(&h, &height, sizeof(h));
+    w ^= h * 0x9e3779b1u ^ kind * 0xc2b2ae35u;
+    w ^= w >> 16;
+    w *= 0x7feb352du;
+    w ^= w >> 15;
+    base = (w & (ARRAY_SIZE(context->primitive_next) - 1)) * 4;
+    for (probe = 0; probe < 4; ++probe)
+    {
+        index = base + probe;
+        if (context->primitive_cache[index].geometry && context->primitive_cache[index].kind == kind
+                && context->primitive_cache[index].size.x == width && context->primitive_cache[index].size.y == height)
+            break;
+    }
+    if (probe == 4)
+        index = base + (context->primitive_next[base / 4]++ & 3);
+    geometry = context->primitive_cache[index].geometry;
+    if (!geometry || context->primitive_cache[index].size.x != width || context->primitive_cache[index].size.y != height
+            || context->primitive_cache[index].kind != kind)
+    {
+        if (kind == 0)
+        {
+            ID2D1PathGeometry *path;
+            ID2D1GeometrySink *sink;
+            D2D1_POINT_2F end = { width, height }, zero = { 0.0f, 0.0f };
+            if (FAILED(ID2D1Factory_CreatePathGeometry(context->factory, &path)))
+                return FALSE;
+            if (FAILED(ID2D1PathGeometry_Open(path, &sink)))
+            {
+                ID2D1PathGeometry_Release(path);
+                return FALSE;
+            }
+            ID2D1GeometrySink_BeginFigure(sink, zero, D2D1_FIGURE_BEGIN_HOLLOW);
+            ID2D1GeometrySink_AddLine(sink, end);
+            ID2D1GeometrySink_EndFigure(sink, D2D1_FIGURE_END_OPEN);
+            hr = ID2D1GeometrySink_Close(sink);
+            ID2D1GeometrySink_Release(sink);
+            geometry = (ID2D1Geometry *)path;
+        }
+        else if (kind == 1)
+        {
+            D2D1_RECT_F rect = { 0.0f, 0.0f, width, height };
+            ID2D1RectangleGeometry *rect_geometry = NULL;
+            hr = ID2D1Factory_CreateRectangleGeometry(context->factory, &rect, &rect_geometry);
+            geometry = (ID2D1Geometry *)rect_geometry;
+        }
+        else
+        {
+            D2D1_ELLIPSE ellipse = { { 0.0f, 0.0f }, width, height };
+            ID2D1EllipseGeometry *ellipse_geometry = NULL;
+            hr = ID2D1Factory_CreateEllipseGeometry(context->factory, &ellipse, &ellipse_geometry);
+            geometry = (ID2D1Geometry *)ellipse_geometry;
+        }
+        if (FAILED(hr))
+        {
+            if (geometry)
+                ID2D1Geometry_Release(geometry);
+            return FALSE;
+        }
+        if (context->primitive_cache[index].geometry)
+            ID2D1Geometry_Release(context->primitive_cache[index].geometry);
+        context->primitive_cache[index].geometry = geometry;
+        context->primitive_cache[index].size.x = width;
+        context->primitive_cache[index].size.y = height;
+        context->primitive_cache[index].kind = kind;
+    }
+    saved = *transform;
+    transform->_31 += x * transform->_11 + y * transform->_21;
+    transform->_32 += x * transform->_12 + y * transform->_22;
+    if (fill)
+        ID2D1DeviceContext6_FillGeometry(&context->ID2D1DeviceContext6_iface, geometry, brush, NULL);
+    else
+        ID2D1DeviceContext6_DrawGeometry(&context->ID2D1DeviceContext6_iface, geometry, brush, stroke_width, style);
+    *transform = saved;
+    return TRUE;
+}
