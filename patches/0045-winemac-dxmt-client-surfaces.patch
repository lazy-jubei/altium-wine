+
+/* DXMT expects the pre-11.16 Mac driver's window-data layout. Expose a
+ * compatibility handle with the old prefix and own a modern client surface
+ * for the lifetime of each DXMT view. The handle is opaque to winemetal. */
+struct dxmt_view_handle
+{
+    HWND hwnd;
+    macdrv_window cocoa_window;
+    macdrv_view cocoa_view;
+    macdrv_view client_token;
+    struct client_surface *surface;
+    macdrv_metal_view metal_view;
+    struct list entry;
+};
+
+static struct dxmt_view_handle dxmt_empty_view;
+static pthread_mutex_t dxmt_views_lock = PTHREAD_MUTEX_INITIALIZER;
+static struct list dxmt_views = LIST_INIT(dxmt_views);
+
+/* Legacy DXMT surfaces are created outside win32u's client-surface set.
+ * Refresh their child clips after Windows changes visibility or stacking. */
+static void dxmt_update_child_clips(HWND hwnd)
+{
+    struct dxmt_view_handle *view;
+    HWND root;
+
+    pthread_mutex_lock(&dxmt_views_lock);
+    if (!list_empty(&dxmt_views) && (root = NtUserGetAncestor(hwnd, GA_ROOT)))
+    {
+        LIST_FOR_EACH_ENTRY(view, &dxmt_views, struct dxmt_view_handle, entry)
+        {
+            if (view->hwnd == root || NtUserGetAncestor(view->hwnd, GA_ROOT) != root) continue;
+            client_surface_sync_child(impl_from_client_surface(view->surface));
+        }
+    }
+    pthread_mutex_unlock(&dxmt_views_lock);
 }
 
+static struct dxmt_view_handle *dxmt_get_win_data(HWND hwnd)
+{
+    struct dxmt_view_handle *view = calloc(1, sizeof(*view));
+
+    if (!view) return &dxmt_empty_view;
+    view->hwnd = hwnd;
+    view->client_token = (macdrv_view)view;
+    return view;
+}
+
+static void dxmt_release_win_data(struct dxmt_view_handle *view)
+{
+    if (view != &dxmt_empty_view && !view->metal_view)
+    {
+        if (view->surface) client_surface_release(view->surface);
+        free(view);
+    }
+}
+
+/* DXMT presents through CAMetalLayer instead of the driver present callback.
+ * When two swapchains share an HWND, activate the one drawing the new frame. */
+static void dxmt_activate_surface(void *context)
+{
+    struct client_surface *client = context;
+    struct macdrv_client_surface *surface = impl_from_client_surface(client);
+    struct macdrv_win_data *data = get_win_data(client->hwnd);
+    BOOL current;
+
+    if (!data) return;
+    current = data->client_view == surface->cocoa_view;
+    release_win_data(data);
+    if (!current) macdrv_client_surface_present(client, 0);
+}
+
+static macdrv_metal_view dxmt_create_metal_view(macdrv_view token, macdrv_metal_device device)
+{
+    struct dxmt_view_handle *view = (struct dxmt_view_handle *)token;
+    struct macdrv_client_surface *surface;
+
+    if (!view || !view->hwnd || !NtUserIsWindow(view->hwnd)) return NULL;
+    if (!(view->surface = macdrv_CreateClientSurface(view->hwnd, 0))) return NULL;
+    surface = impl_from_client_surface(view->surface);
+    view->metal_view = macdrv_view_create_metal_view(surface->cocoa_view, device);
+    if (!view->metal_view) return NULL;
+    pthread_mutex_lock(&dxmt_views_lock);
+    list_add_tail(&dxmt_views, &view->entry);
+    pthread_mutex_unlock(&dxmt_views_lock);
+    macdrv_view_set_drawable_callback(view->metal_view, dxmt_activate_surface, view->surface);
+    return (macdrv_metal_view)view;
+}
+
+static macdrv_metal_layer dxmt_get_metal_layer(macdrv_metal_view handle)
+{
+    struct dxmt_view_handle *view = (struct dxmt_view_handle *)handle;
+    return macdrv_view_get_metal_layer(view->metal_view);
+}
+
+static void dxmt_release_metal_view(macdrv_metal_view handle)
+{
+    struct dxmt_view_handle *view = (struct dxmt_view_handle *)handle;
+
+    if (!view) return;
+    pthread_mutex_lock(&dxmt_views_lock);
+    list_remove(&view->entry);
+    pthread_mutex_unlock(&dxmt_views_lock);
+    macdrv_view_set_drawable_callback(view->metal_view, NULL, NULL);
+    macdrv_view_release_metal_view(view->metal_view);
+    view->metal_view = NULL;
+    dxmt_release_win_data(view);
+}
+
+/* Legacy DXMT symbol table. Unused entries retain their positions in the ABI. */
+const struct
+{
+    void *init_display_devices;
+    struct dxmt_view_handle *(*get_win_data)(HWND);
+    void (*release_win_data)(struct dxmt_view_handle *);
+    void *get_cocoa_window;
+    macdrv_metal_device (*create_metal_device)(void);
+    void (*release_metal_device)(macdrv_metal_device);
+    macdrv_metal_view (*create_metal_view)(macdrv_view, macdrv_metal_device);
+    macdrv_metal_layer (*get_metal_layer)(macdrv_metal_view);
+    void (*release_metal_view)(macdrv_metal_view);
+    void *on_main_thread;
+} macdrv_functions __attribute__((visibility("default"))) =
+{
+    .get_win_data = dxmt_get_win_data,
+    .release_win_data = dxmt_release_win_data,
+    .create_metal_device = macdrv_create_metal_device,
+    .release_metal_device = macdrv_release_metal_device,
+    .create_metal_view = dxmt_create_metal_view,
+    .get_metal_layer = dxmt_get_metal_layer,
+    .release_metal_view = dxmt_release_metal_view,
+};
