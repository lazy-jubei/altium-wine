--- a/dlls/winemac.drv/window.c
+++ b/dlls/winemac.drv/window.c
@@ -1982,12 +1982,50 @@
  *
  * Handler for APP_ACTIVATED events.
  */
+void macdrv_raise_modal_popup(HWND popup)
+{
+    struct macdrv_win_data *data;
+    HWND owner = NtUserGetAncestor(popup, GA_ROOTOWNER);
+
+    NtUserSetWindowPos(popup, HWND_TOP, 0, 0, 0, 0,
+            SWP_NOMOVE | SWP_NOSIZE | SWP_NOACTIVATE | SWP_NOOWNERZORDER);
+    NtUserSetForegroundWindowInternal(popup);
+    /* Cocoa orders owned windows as a group. Raise the disabled root owner
+     * first so the group clears a separately owned main form. */
+    if (owner && owner != popup && (data = get_win_data(owner)))
+    {
+        if (data->cocoa_window)
+            macdrv_order_cocoa_window(data->cocoa_window, NULL, NULL, FALSE);
+        release_win_data(data);
+    }
+    if (!(data = get_win_data(popup))) return;
+    /* SetWindowPos can be a no-op when Wine's order is already correct.
+     * Explicitly repair the native order after Cocoa app activation. */
+    if (data->cocoa_window && data->on_screen)
+        macdrv_order_cocoa_window(data->cocoa_window, NULL, NULL, FALSE);
+    release_win_data(data);
+}
+
+
