 {
     HWND active = get_active_window();
-
-    TRACE("active %p\n", active);
+    HWND popup = macdrv_get_blocking_popup(active);
+
+    /* The active dialog may already be first in Wine's z order while Cocoa
+     * has raised the separately owned main window above it. */
+    if (!popup && active && NtUserIsWindowEnabled(active))
+    {
+        HWND owner = NtUserGetAncestor(active, GA_ROOTOWNER);
+        if (owner != active && owner && !NtUserIsWindowEnabled(owner)) popup = active;
+    }
+    TRACE("active %p, blocking popup %p\n", active, popup);
     macdrv_UpdateClipboard();
+    if (popup)
+    {
+        active = popup;
+        macdrv_raise_modal_popup(popup);
+    }
 
     /* Altium-on-Wine kit: when the app comes back to the front, put its active window (often a
      * modal dialog) back on top; Cocoa may have ordered another of our windows above it. */
@@ -2091,7 +2129,14 @@
  */
 void macdrv_window_brought_forward(HWND hwnd)
 {
-    TRACE("win %p\n", hwnd);
+    HWND popup = macdrv_get_blocking_popup(hwnd);
+
+    TRACE("win %p, blocking popup %p\n", hwnd, popup);
+    if (popup)
+    {
+        macdrv_raise_modal_popup(popup);
+        return;
+    }
     NtUserSetWindowPos(hwnd, HWND_TOP, 0, 0, 0, 0, SWP_NOMOVE | SWP_NOSIZE | SWP_NOACTIVATE);
 }
 
