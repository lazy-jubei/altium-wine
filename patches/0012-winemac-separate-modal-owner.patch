From: Altium-on-Wine kit
Subject: winemac.drv: Recover separately owned modal dialogs after deactivation

Base: 0000 + 0002 + 0007

The foreground desktop is not the blocking dialog. Find an enabled popup on
the same GUI thread whose separate root owner is disabled, excluding no-activate
overlays and modeless panels. Recover it on mouse activation and app activation.

--- a/dlls/winemac.drv/mouse.c
+++ b/dlls/winemac.drv/mouse.c
@@ -831,32 +831,50 @@
  *
  * Handler for MOUSE_BUTTON events.
  */
-/* Altium-on-Wine kit: like Windows, a click on a window that a modal dialog has disabled
- * brings that dialog forward. Without this, Cocoa raises the clicked (disabled) window over
- * its own dialog and the app looks frozen. Delphi apps hit this all the time: dialogs are owned
- * by the hidden TApplication window, so no owner/owned ordering keeps the dialog above the main
- * form. The dialog is either the last active popup of the disabled window's owner chain or, when
- * the main form is not owned by the TApplication window (Altium Designer 17), the foreground
- * window of the same thread. */
+/* Delphi's main form can be unowned while its modal dialog is owned by a
+ * separate, disabled TApplication window. After application deactivation the
+ * foreground window is the desktop, so it cannot identify that dialog. */
+static BOOL is_activatable_popup(HWND popup, DWORD thread)
+{
+    return popup && NtUserGetWindowThread(popup, NULL) == thread
+            && NtUserIsWindowVisible(popup) && NtUserIsWindowEnabled(popup)
+            && !(NtUserGetWindowLongW(popup, GWL_EXSTYLE) & WS_EX_NOACTIVATE);
+}
+
+HWND macdrv_get_blocking_popup(HWND hwnd)
+{
+    HWND owner, popup;
+    DWORD thread = hwnd ? NtUserGetWindowThread(hwnd, NULL) : GetCurrentThreadId();
+
+    if (hwnd && NtUserIsWindowEnabled(hwnd)) return NULL;
+    owner = hwnd ? NtUserGetAncestor(hwnd, GA_ROOTOWNER) : NULL;
+    popup = owner ? NtUserGetLastActivePopup(owner) : NULL;
+    if (popup != hwnd && popup != owner && is_activatable_popup(popup, thread)) return popup;
+
+    popup = NtUserGetForegroundWindow();
+    if (popup != hwnd && popup != owner && is_activatable_popup(popup, thread)) return popup;
+
+    /* Walk in z order and accept only an owned popup whose root owner is
+     * disabled. Exclude tooltips / heads-up overlays (WS_EX_NOACTIVATE),
+     * modeless panels and windows belonging to other threads. */
+    for (popup = NtUserGetWindowRelative(NtUserGetDesktopWindow(), GW_CHILD); popup;
+            popup = NtUserGetWindowRelative(popup, GW_HWNDNEXT))
+    {
+        if (popup == hwnd || !is_activatable_popup(popup, thread)
+                || !(NtUserGetWindowLongW(popup, GWL_STYLE) & WS_POPUP)) continue;
+        owner = NtUserGetAncestor(popup, GA_ROOTOWNER);
+        if (owner && owner != popup && !NtUserIsWindowEnabled(owner)) return popup;
+    }
+    return NULL;
+}
+
