From: Altium-on-Wine kit
Subject: msado15: Implement the simple Command and Parameter properties, and Parameters.Item

Modules: dlls/msado15
Base: wine-11.16 (wine-staging does not touch msado15)

Altium Designer 17's integrated library server (Delphi ADO components) builds a
Command, sets CommandTimeout, creates a Parameter and reads its NumericScale/Precision,
then sets Prepared. Each of these was a FIXME returning E_NOTIMPL, which Delphi turns
into an EOleException; the server then failed to initialize and Altium 17 crashed at
startup with an access violation in IntegratedLibrary.DLL.

Command: CommandTimeout (default 30), Prepared, Name, State (adStateClosed), Cancel,
Dialect (default DBGUID_DEFAULT) and NamedParameters are now stored properties.
Parameter: Precision, NumericScale, Attributes (default adParamSigned) and AppendChunk
(for empty and string values). Parameters.Item looks parameters up by index or name.
Also initialize Parameter.value before VariantCopy() into it.

--- a/dlls/msado15/command.c
+++ b/dlls/msado15/command.c
@@ -46,6 +46,11 @@
     CommandTypeEnum  type;
     BSTR             text;
     _Connection     *connection;
+    LONG             timeout;
+    VARIANT_BOOL     prepared;
+    VARIANT_BOOL     named_parameters;
+    BSTR             name;
+    BSTR             dialect;
 
     struct list parameters;
 };
@@ -60,6 +65,9 @@
     ParameterDirectionEnum direction;
     ADO_LONGPTR size;
     VARIANT value;
+    unsigned char precision;
+    unsigned char scale;
+    LONG attributes;
 };
 
 static inline struct parameter *impl_from_Parameter( _Parameter *iface )
@@ -241,8 +249,50 @@
 
 static HRESULT WINAPI parameters_get_Item(Parameters *iface, VARIANT index, _Parameter **object)
 {
-    FIXME( "%p, %s, %p\n", iface, debugstr_variant(&index), object);
-    return E_NOTIMPL;
+    struct command *command = impl_from_Parameters( iface );
+    struct param_item *para;
+    VARIANT num;
+    int cnt = 0;
+
+    TRACE( "%p, %s, %p\n", iface, debugstr_variant(&index), object);
+
+    if (!object) return E_POINTER;
+    *object = NULL;
+
+    if (V_VT(&index) == VT_BSTR)
+    {
+        LIST_FOR_EACH_ENTRY(para, &command->parameters, struct param_item, entry)
+        {
+            _Parameter *parameter;
+            BSTR name = NULL;
+            BOOL match;
+
+            if (FAILED(IDispatch_QueryInterface( para->param, &IID__Parameter, (void **)&parameter ))) continue;
+            match = SUCCEEDED(_Parameter_get_Name( parameter, &name )) && name && V_BSTR(&index) &&
+                    !wcsicmp( name, V_BSTR(&index) );
+            SysFreeString( name );
+            if (match)
+            {
+                *object = parameter;
+                return S_OK;
+            }
+            _Parameter_Release( parameter );
+        }
+        return MAKE_ADO_HRESULT(adErrItemNotFound);
+    }
+
+    VariantInit( &num );
+    if (FAILED(VariantChangeType( &num, &index, 0, VT_I4 )))
+    {
+        FIXME("Unsupported index type %d\n", V_VT(&index));
+        return MAKE_ADO_HRESULT(adErrItemNotFound);
+    }
+    LIST_FOR_EACH_ENTRY(para, &command->parameters, struct param_item, entry)
+    {
+        if (cnt++ == V_I4(&num))
+            return IDispatch_QueryInterface( para->param, &IID__Parameter, (void **)object );
+    }
+    return MAKE_ADO_HRESULT(adErrItemNotFound);
 }
 
