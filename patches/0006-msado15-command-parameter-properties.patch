 static HRESULT WINAPI parameter_AppendChunk(_Parameter *iface, VARIANT val)
 {
     struct parameter *parameter = impl_from_Parameter( iface );
-    FIXME("%p, %s\n", parameter, debugstr_variant(&val));
+    BSTR joined;
+
+    TRACE("%p, %s\n", parameter, debugstr_variant(&val));
+
+    if (V_VT(&parameter->value) == VT_EMPTY || V_VT(&parameter->value) == VT_NULL)
+    {
+        VariantClear( &parameter->value );
+        return VariantCopy( &parameter->value, &val );
+    }
+    if (V_VT(&parameter->value) == VT_BSTR && V_VT(&val) == VT_BSTR)
+    {
+        UINT len = SysStringLen( V_BSTR(&parameter->value) );
+        if (!(joined = SysAllocStringLen( NULL, len + SysStringLen( V_BSTR(&val) ) ))) return E_OUTOFMEMORY;
+        memcpy( joined, V_BSTR(&parameter->value), len * sizeof(WCHAR) );
+        memcpy( joined + len, V_BSTR(&val), SysStringLen( V_BSTR(&val) ) * sizeof(WCHAR) );
+        SysFreeString( V_BSTR(&parameter->value) );
+        V_BSTR(&parameter->value) = joined;
+        return S_OK;
+    }
+    FIXME("%p, appending %s to %s\n", parameter, debugstr_variant(&val), debugstr_variant(&parameter->value));
     return E_NOTIMPL;
 }
 
