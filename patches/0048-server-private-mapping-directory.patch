+/* A private directory can hold transient mapping files independently of the prefix. */
+static int open_mapping_dir(void)
+{
+    const char *path = getenv( "ALTIUM_WINE_MAPPING_DIR" );
+    struct stat st;
+    int fd;
+
+    if (!path || !*path) return -1;
+    if (path[0] != '/') goto fallback;
+    fd = open( path, O_RDONLY | O_DIRECTORY | O_NOFOLLOW | O_CLOEXEC );
+    if (fd != -1)
+    {
+        if (!fstat( fd, &st ) && st.st_uid == getuid() && !(st.st_mode & 077) &&
+            check_dir_for_exec( fd ))
+            return fd;
+        close( fd );
+    }
+fallback:
+    fprintf( stderr, "wineserver: cannot use ALTIUM_WINE_MAPPING_DIR; using the normal directory\n" );
+    return -1;
+}
+
+static int create_mapping_file_at( int dir_fd, file_pos_t size )
+{
+    char tmpfn[16];
+    int fd = make_temp_file( dir_fd, tmpfn );
+
+    if (fd == -1)
+        file_set_error();
+    else
+    {
+        if (!grow_file( fd, size ))
+        {
+            close( fd );
+            fd = -1;
+        }
+        unlinkat( dir_fd, tmpfn, 0 );
+    }
+    return fd;
 }
 
