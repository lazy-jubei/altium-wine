+
+void
+D3D11DXGISurface::DestroyDC() {
+  if (gdi_old_bitmap_ && gdi_old_bitmap_ != HGDI_ERROR)
+    SelectObject(gdi_dc_, gdi_old_bitmap_);
+  if (gdi_dc_)
+    DeleteDC(gdi_dc_);
+  if (gdi_bitmap_)
+    DeleteObject(gdi_bitmap_);
+
+  gdi_dc_ = nullptr;
+  gdi_bitmap_ = nullptr;
+  gdi_old_bitmap_ = nullptr;
+  gdi_pixels_ = nullptr;
+}
