 HRESULT STDMETHODCALLTYPE
 D3D11DXGISurface::GetDC(BOOL Discard, HDC *phdc) {
-  // TODO(gdi-surface)
-  return DXGI_ERROR_INVALID_CALL;
+  if (!phdc)
+    return DXGI_ERROR_INVALID_CALL;
+  *phdc = nullptr;
+
+  std::lock_guard lock(gdi_mutex_);
+  if (gdi_dc_)
+    return DXGI_ERROR_INVALID_CALL;
+
+  D3D11_RESOURCE_DIMENSION dimension;
+  resource_->GetType(&dimension);
+  if (dimension != D3D11_RESOURCE_DIMENSION_TEXTURE2D)
+    return DXGI_ERROR_INVALID_CALL;
+
+  D3D11_TEXTURE2D_DESC desc;
+  GetResourceCommon(resource_)->GetDesc(&desc);
+  if (!(desc.MiscFlags & D3D11_RESOURCE_MISC_GDI_COMPATIBLE) ||
+      desc.SampleDesc.Count != 1 ||
+      (desc.Format != DXGI_FORMAT_B8G8R8A8_UNORM &&
+       desc.Format != DXGI_FORMAT_B8G8R8A8_UNORM_SRGB &&
+       desc.Format != DXGI_FORMAT_B8G8R8A8_TYPELESS))
+    return DXGI_ERROR_INVALID_CALL;
+
+  DXGI_SURFACE_DESC surface_desc;
+  if (FAILED(GetDesc(&surface_desc)))
+    return DXGI_ERROR_INVALID_CALL;
+
+  BITMAPINFO info = {};
+  info.bmiHeader.biSize = sizeof(BITMAPINFOHEADER);
+  info.bmiHeader.biWidth = LONG(surface_desc.Width);
+  info.bmiHeader.biHeight = -LONG(surface_desc.Height);
+  info.bmiHeader.biPlanes = 1;
+  info.bmiHeader.biBitCount = 32;
+  info.bmiHeader.biCompression = BI_RGB;
+  gdi_dc_ = CreateCompatibleDC(nullptr);
+  if (gdi_dc_)
+    gdi_bitmap_ = CreateDIBSection(gdi_dc_, &info, DIB_RGB_COLORS, &gdi_pixels_, nullptr, 0);
+  if (gdi_bitmap_)
+    gdi_old_bitmap_ = SelectObject(gdi_dc_, gdi_bitmap_);
+  if (!gdi_old_bitmap_ || gdi_old_bitmap_ == HGDI_ERROR) {
+    DestroyDC();
+    return E_OUTOFMEMORY;
+  }
+
+  if (!Discard) {
+    Com<ID3D11Device> device;
+    Com<ID3D11DeviceContext> context;
+    Com<ID3D11Texture2D> staging;
+    resource_->GetDevice(&device);
+    device->GetImmediateContext(&context);
+
+    desc.Width = surface_desc.Width;
+    desc.Height = surface_desc.Height;
+    desc.MipLevels = 1;
+    desc.ArraySize = 1;
+    const UINT row_size = desc.Width * 4;
+    desc.Usage = D3D11_USAGE_STAGING;
+    desc.BindFlags = 0;
+    desc.CPUAccessFlags = D3D11_CPU_ACCESS_READ;
+    desc.MiscFlags = 0;
+    HRESULT hr = device->CreateTexture2D(&desc, nullptr, &staging);
+    if (SUCCEEDED(hr)) {
+      context->CopySubresourceRegion(staging.ptr(), 0, 0, 0, 0, resource_, subresource_, nullptr);
+      D3D11_MAPPED_SUBRESOURCE mapped;
+      hr = context->Map(staging.ptr(), 0, D3D11_MAP_READ, 0, &mapped);
+      if (SUCCEEDED(hr)) {
+        auto pixels = static_cast<unsigned char *>(gdi_pixels_);
+        auto source = static_cast<const unsigned char *>(mapped.pData);
+        for (UINT y = 0; y < desc.Height; ++y)
+          std::memcpy(pixels + size_t(y) * row_size, source + size_t(y) * mapped.RowPitch, row_size);
+        context->Unmap(staging.ptr(), 0);
+      }
+    }
+    if (FAILED(hr)) {
+      DestroyDC();
+      return hr;
+    }
+  }
+
+  *phdc = gdi_dc_;
+  return S_OK;
 }
 
 HRESULT STDMETHODCALLTYPE
 D3D11DXGISurface::ReleaseDC(RECT *pDirtyRect) {
-  // TODO(gdi-surface)
-  return DXGI_ERROR_INVALID_CALL;
+  std::lock_guard lock(gdi_mutex_);
+  if (!gdi_dc_)
+    return DXGI_ERROR_INVALID_CALL;
+
+  DXGI_SURFACE_DESC desc;
+  GetDesc(&desc);
+  RECT bounds = {0, 0, LONG(desc.Width), LONG(desc.Height)};
+  RECT dirty = bounds;
+  if (pDirtyRect)
+    IntersectRect(&dirty, &bounds, pDirtyRect);
+
+  GdiFlush();
+  if (!IsRectEmpty(&dirty)) {
+    Com<ID3D11Device> device;
+    Com<ID3D11DeviceContext> context;
+    resource_->GetDevice(&device);
+    device->GetImmediateContext(&context);
+
+    const UINT row_size = desc.Width * 4;
+    auto pixels = static_cast<const unsigned char *>(gdi_pixels_);
+    const D3D11_BOX box = {UINT(dirty.left), UINT(dirty.top), 0, UINT(dirty.right), UINT(dirty.bottom), 1};
+    context->UpdateSubresource(resource_, subresource_, &box,
+                               pixels + size_t(dirty.top) * row_size + dirty.left * 4,
+                               row_size, 0);
+  }
+
+  DestroyDC();
+  return S_OK;
 }
 
