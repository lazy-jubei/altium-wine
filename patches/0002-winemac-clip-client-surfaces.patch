+/* Altium-on-Wine kit: a child window's client surface (GL/Vulkan/Metal) is a flat subview
+ * of the toplevel Cocoa window, layered above everything Win32 draws into the window, and it
+ * ignored the child's Win32 visibility, z-order and clipping. So when an app switched between
+ * child views (e.g. document tabs), or showed a child panel over the view, the Metal layer
+ * stayed on top and covered it. Clip the view to the child's real visible region (which
+ * accounts for hidden ancestors and siblings above it), and hide it when nothing is visible.
+ *
+ * Known limitation: this runs when the surface is updated or presented. A child that stops
+ * presenting and is then covered keeps its last clip until win32u updates its client surfaces
+ * again (which it does on any position, visibility or z-order change of the window itself). */
+static int client_surface_get_clip(struct macdrv_client_surface *surface, RECT **ret_rects)
+{
+    HWND hwnd = surface->client.hwnd;
+    RECT full = surface->client.monitor_rect;
+    UINT flags = DCX_CACHE | DCX_CLIPSIBLINGS;
+    int count = -1;  /* unclipped unless we learn otherwise */
+    RGNDATA *data = NULL;
+    HRGN region;
+    DWORD size;
+    HDC hdc;
+
+    *ret_rects = NULL;
+    OffsetRect(&full, -full.left, -full.top);
+
+    /* The Cocoa view is above every sibling, so always clip siblings that are above the window
+     * in Win32 z-order, whatever its style. Children follow the style, as they would on Windows. */
+    if (NtUserGetWindowLongW(hwnd, GWL_STYLE) & WS_CLIPCHILDREN) flags |= DCX_CLIPCHILDREN;
+    if (!(hdc = NtUserGetDCEx(hwnd, 0, flags))) return -1;
+    if ((region = NtGdiCreateRectRgn(0, 0, 0, 0)))
+    {
+        if (NtGdiGetRandomRgn(hdc, region, SYSRGN | NTGDI_RGN_MONITOR_DPI) > 0 &&
+            (size = NtGdiGetRegionData(region, 0, NULL)) && (data = malloc(size)) &&
+            NtGdiGetRegionData(region, size, data))
+        {
+            RECT *rects = (RECT *)data->Buffer;
+            count = data->rdh.nCount;
+            if (count == 1 && rects[0].left <= full.left && rects[0].top <= full.top &&
+                rects[0].right >= full.right && rects[0].bottom >= full.bottom)
+                count = -1;
+            else if (count > 0 && (*ret_rects = malloc(count * sizeof(RECT))))
+                memcpy(*ret_rects, rects, count * sizeof(RECT));
+            else if (count > 0)
+                count = -1;
+        }
+        free(data);
+        NtGdiDeleteObjectApp(region);
+    }
+    NtUserReleaseDC(hwnd, hdc);
+    return count;
+}
+
+/* Apply a clip computed by client_surface_get_clip(); count -1 removes the mask. Must be called
+ * with the window's win_data held. Returns FALSE (cache untouched) if it couldn't be applied. */
+static BOOL client_surface_set_clip(struct macdrv_client_surface *surface, RECT *rects, int count)
+{
+    if (count == surface->clip_count &&
+        (count <= 0 || !memcmp(rects, surface->clip_rects, count * sizeof(RECT))))
+        return TRUE;
+
+    TRACE("%s clip count %d\n", debugstr_client_surface(&surface->client), count);
+    if (count > 0)
+    {
+        CGRect *cgrects;
+        RECT *copy;
+        int i;
+
+        if (!(cgrects = malloc(count * sizeof(CGRect)))) return FALSE;
+        if (!(copy = malloc(count * sizeof(RECT))))
+        {
+            free(cgrects);
+            return FALSE;
+        }
+        for (i = 0; i < count; i++) cgrects[i] = cgrect_from_rect(rects[i]);
+        macdrv_set_view_clip_rects(surface->cocoa_view, cgrects, count);
+        free(cgrects);
+        memcpy(copy, rects, count * sizeof(RECT));
+        free(surface->clip_rects);
+        surface->clip_rects = copy;
+    }
+    else
+    {
+        macdrv_set_view_clip_rects(surface->cocoa_view, NULL, 0);
+        free(surface->clip_rects);
+        surface->clip_rects = NULL;
+    }
+    surface->clip_count = count;
+    return TRUE;
+}
+
+static void client_surface_set_hidden(struct macdrv_client_surface *surface, int hidden)
+{
+    if (surface->hidden == hidden) return;
+
+    TRACE("%s hidden %d\n", debugstr_client_surface(&surface->client), hidden);
+    surface->hidden = hidden;
+    macdrv_set_view_hidden(surface->cocoa_view, hidden);
+}
+
+/* Bring a child surface's view clip and visibility up to date. The clip is computed outside
+ * the win_data lock (it goes through win32u), then the presented check, mask and visibility
+ * change are done together under it, so a concurrent present on the same window can't leave
+ * two views shown. The mask is always set before a view is shown and never touched while a
+ * view is being hidden, so a view never shows a frame without its clip. */
+static void client_surface_sync_child(struct macdrv_client_surface *surface)
+{
+    HWND hwnd = surface->client.hwnd;
+    struct macdrv_win_data *data;
+    RECT *rects;
+    int count, hidden;
+
+    count = client_surface_get_clip(surface, &rects);
+
+    if ((data = get_win_data(hwnd)))
+    {
+        hidden = data->client_view != surface->cocoa_view || count == 0;
+        if (hidden)
+            client_surface_set_hidden(surface, 1);
+        else if (client_surface_set_clip(surface, rects, count))
+            client_surface_set_hidden(surface, 0);
+        release_win_data(data);
+    }
+    free(rects);
+}
+
 static void macdrv_client_surface_update(struct client_surface *client)
 {
     struct macdrv_client_surface *surface = impl_from_client_surface(client);
