 /***********************************************************************
+ *              macdrv_set_view_clip_rects
+ *
+ * Altium-on-Wine kit: clip a client-surface view to the visible part of its
+ * Win32 window (rects in Win32 coordinates relative to the view), so sibling
+ * windows above it (pop-out panels, other document views) aren't covered by
+ * the Metal layer. NULL rects removes the clip.
+ */
+void macdrv_set_view_clip_rects(macdrv_view v, const CGRect *rects, int count)
+{
+@autoreleasepool
+{
+    WineContentView* view = (WineContentView*)v;
+    CGMutablePathRef path = NULL;
+    int i;
+
+    if (rects)
+    {
+        path = CGPathCreateMutable();
+        for (i = 0; i < count; i++)
+            CGPathAddRect(path, NULL, cgrect_mac_from_win(rects[i]));
+    }
+
+    OnMainThreadAsync(^{
+        CALayer* layer = [view layer];
+        CAShapeLayer* mask = (CAShapeLayer*)layer.mask;
+
+        [CATransaction begin];
+        [CATransaction setDisableActions:YES];
+        if (!path)
+            layer.mask = nil;
+        else
+        {
+            if (!mask) layer.mask = mask = [CAShapeLayer layer];
+            mask.contentsScale = layer.contentsScale;
+            mask.path = path;
+        }
+        [CATransaction commit];
+        if (path) CGPathRelease(path);
+    });
+}
+}
+
+/***********************************************************************
  *              macdrv_set_view_hidden
  */
 void macdrv_set_view_hidden(macdrv_view v, bool hidden)
