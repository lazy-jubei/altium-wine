     macdrv_set_view_superview(surface->cocoa_view, toplevel == hwnd ? NULL : data->client_view, data->cocoa_window, NULL, NULL);
+    /* A window that became a toplevel owns its whole Cocoa window: drop any child clip. */
+    if (toplevel == hwnd) client_surface_set_clip(surface, NULL, -1);
     release_win_data(data);
+
+    if (toplevel != hwnd) client_surface_sync_child(surface);
 }
 
