+static unsigned int glyph_hash_bytes(unsigned int hash, const void *data, size_t size)
+{
+    const unsigned char *p = data;
+    while (size--) hash = (hash ^ *p++) * 16777619u;
+    return hash;
+}
+
+static unsigned int glyph_run_hash(const DWRITE_GLYPH_RUN *run)
+{
+    unsigned int hash = 2166136261u, flags = (run->isSideways ? 1 : 0) | ((run->bidiLevel & 1) << 1);
+
+    hash = glyph_hash_bytes(hash, &run->fontFace, sizeof(run->fontFace));
+    hash = glyph_hash_bytes(hash, &run->fontEmSize, sizeof(run->fontEmSize));
+    hash = glyph_hash_bytes(hash, &flags, sizeof(flags));
+    hash = glyph_hash_bytes(hash, run->glyphIndices, run->glyphCount * sizeof(*run->glyphIndices));
+    if (run->glyphAdvances)
+        hash = glyph_hash_bytes(hash, run->glyphAdvances, run->glyphCount * sizeof(*run->glyphAdvances));
+    if (run->glyphOffsets)
