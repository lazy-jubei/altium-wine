+    return e->hash == hash && e->font_face == run->fontFace && e->em_size == run->fontEmSize
+            && e->sideways == !!run->isSideways && e->rtl == (run->bidiLevel & 1) && e->count == n
+            && !memcmp(e->indices, run->glyphIndices, n * sizeof(*e->indices))
+            && !e->advances == !run->glyphAdvances
+            && (!e->advances || !memcmp(e->advances, run->glyphAdvances, n * sizeof(*e->advances)))
+            && !e->offsets == !run->glyphOffsets
+            && (!e->offsets || !memcmp(e->offsets, run->glyphOffsets, n * sizeof(*e->offsets)));
