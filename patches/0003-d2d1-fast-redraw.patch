+struct glyph_geometry_entry
+{
+    struct list entry;
+    unsigned int hash;
+    IDWriteFontFace *font_face;
+    float em_size;
+    BOOL sideways;
+    BOOL rtl;
+    UINT32 count;
+    UINT16 *indices;
+    float *advances;
+    DWRITE_GLYPH_OFFSET *offsets;
+    ID2D1PathGeometry *geometry;
+};
+
+#define GLYPH_GEOMETRY_BUCKETS 4096
+#define GLYPH_GEOMETRY_MAX_GLYPHS 65536
+#define GLYPH_GEOMETRY_MAX_RUN 256
+
+struct d2d_glyph_cache
