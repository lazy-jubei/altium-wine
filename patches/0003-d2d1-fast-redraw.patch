+static void glyph_entry_free(struct glyph_geometry_entry *e)
+{
+    ID2D1PathGeometry_Release(e->geometry);
+    IDWriteFontFace_Release(e->font_face);
+    free(e->indices);
+    free(e->advances);
+    free(e->offsets);
