+static CRITICAL_SECTION d2d_buffer_cache_cs;
+static CRITICAL_SECTION_DEBUG d2d_buffer_cache_cs_debug =
+{
+    0, 0, &d2d_buffer_cache_cs,
+    { &d2d_buffer_cache_cs_debug.ProcessLocksList, &d2d_buffer_cache_cs_debug.ProcessLocksList },
+      0, 0, { (DWORD_PTR)(__FILE__ ": d2d_buffer_cache_cs") }
+};
+static CRITICAL_SECTION d2d_buffer_cache_cs = { &d2d_buffer_cache_cs_debug, -1, 0, 0, 0, 0 };
+
+static ID3D11Buffer *d2d_geometry_get_buffer(struct d2d_device_context *render_target,
+        const struct d2d_geometry *geometry, enum d2d_geometry_buffer index, const void *data, UINT size, UINT bind)
+{
+    struct d2d_geometry *cache = (struct d2d_geometry *)geometry;
     D3D11_SUBRESOURCE_DATA buffer_data;
     D3D11_BUFFER_DESC buffer_desc;
+    ID3D11Buffer *buffer = NULL;
+    BOOL cacheable;
+
+    EnterCriticalSection(&d2d_buffer_cache_cs);
+    if (!cache->d3d_cache.device)
+        cache->d3d_cache.device = render_target->d3d_device;
+    cacheable = cache->d3d_cache.device == render_target->d3d_device;
+    if (cacheable && cache->d3d_cache.slots[index].buffer && cache->d3d_cache.slots[index].size == size)
+    {
+        buffer = cache->d3d_cache.slots[index].buffer;
+        ID3D11Buffer_AddRef(buffer);
+        LeaveCriticalSection(&d2d_buffer_cache_cs);
+        return buffer;
+    }
+
+    buffer_desc.ByteWidth = size;
+    buffer_desc.Usage = D3D11_USAGE_IMMUTABLE;
+    buffer_desc.BindFlags = bind;
+    buffer_desc.CPUAccessFlags = 0;
+    buffer_desc.MiscFlags = 0;
+    buffer_data.pSysMem = data;
+    buffer_data.SysMemPitch = 0;
+    buffer_data.SysMemSlicePitch = 0;
+    if (FAILED(ID3D11Device1_CreateBuffer(render_target->d3d_device, &buffer_desc, &buffer_data, &buffer)))
+        buffer = NULL;
+    else if (cacheable)
+    {
+        if (cache->d3d_cache.slots[index].buffer)
+            ID3D11Buffer_Release(cache->d3d_cache.slots[index].buffer);
+        cache->d3d_cache.slots[index].buffer = buffer;
+        cache->d3d_cache.slots[index].size = size;
+        ID3D11Buffer_AddRef(buffer);
+    }
+    LeaveCriticalSection(&d2d_buffer_cache_cs);
+    return buffer;
+}
