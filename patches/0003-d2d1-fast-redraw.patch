+/* Altium-on-Wine kit: Wine swapped the whole D3D11 device context state in and out around
+ * every single primitive (2 SwapDeviceContextState calls per draw). Under DXVK each swap
+ * rebinds and revalidates everything, and apps like Altium issue thousands of primitives per
+ * frame, so that alone cost ~150 ms per schematic redraw. Like native D2D, keep our state
+ * bound from the first draw until control goes back to the application (EndDraw, Flush,
+ * GDI interop, SetTarget, destruction, and ID2D1Multithread::Enter for apps that use the
+ * device from other threads), and only swap there. A small registry ensures that only one
+ * D2D context at a time owns a given D3D device's state. All swaps happen with the
+ * context's factory lock (if multithreaded) and d2d_state_cs held.
+ * WINE_D2D_LAZY_STATE=0 restores the original per-draw behaviour. */
+static CRITICAL_SECTION d2d_state_cs;
+static CRITICAL_SECTION_DEBUG d2d_state_cs_debug =
+{
+    0, 0, &d2d_state_cs,
+    { &d2d_state_cs_debug.ProcessLocksList, &d2d_state_cs_debug.ProcessLocksList },
+      0, 0, { (DWORD_PTR)(__FILE__ ": d2d_state_cs") }
+};
+static CRITICAL_SECTION d2d_state_cs = { &d2d_state_cs_debug, -1, 0, 0, 0, 0 };
+static struct
+{
+    ID3D11Device1 *device;
+    struct d2d_device_context *context;
+} d2d_state_owners[32];
+
+static BOOL d2d_lazy_state_enabled(void)
+{
+    static LONG enabled = -1;
+
+    if (enabled == -1)
+    {
+        WCHAR buffer[8];
+        DWORD len = GetEnvironmentVariableW(L"WINE_D2D_LAZY_STATE", buffer, ARRAY_SIZE(buffer));
+        InterlockedExchange(&enabled, !(len && len < ARRAY_SIZE(buffer) && buffer[0] == '0'));
+    }
+    return enabled;
+}
+
+/* d2d_state_cs held, and context->cs (if any) held by the caller. */
+static void d2d_device_context_restore_app_state_locked(struct d2d_device_context *context)
+{
+    ID3D11DeviceContext1 *d3d_context;
+    unsigned int i;
+
+    if (!context->d2d_state_active)
+        return;
+
+    ID3D11Device1_GetImmediateContext1(context->d3d_device, &d3d_context);
+    ID3D11DeviceContext1_SwapDeviceContextState(d3d_context, context->app_state, NULL);
+    ID3D11DeviceContext1_Release(d3d_context);
+    if (context->app_state)
+        ID3DDeviceContextState_Release(context->app_state);
+    context->app_state = NULL;
+    context->d2d_state_active = FALSE;
+
+    for (i = 0; i < ARRAY_SIZE(d2d_state_owners); ++i)
+    {
+        if (d2d_state_owners[i].context == context)
+        {
+            d2d_state_owners[i].context = NULL;
+            d2d_state_owners[i].device = NULL;
+        }
+    }
+}
+
+static void d2d_device_context_restore_app_state(struct d2d_device_context *context)
+{
+    if (!context->d2d_state_active)
+        return;
+
+    if (context->cs)
+        EnterCriticalSection(context->cs);
+    EnterCriticalSection(&d2d_state_cs);
+    d2d_device_context_restore_app_state_locked(context);
+    LeaveCriticalSection(&d2d_state_cs);
+    if (context->cs)
+        LeaveCriticalSection(context->cs);
+}
+
+/* Called from ID2D1Multithread::Enter with the factory lock held: give the D3D device back
+ * to the application in its own state before it uses it. */
+void d2d_factory_restore_app_states(CRITICAL_SECTION *factory_cs)
+{
+    unsigned int i;
+
+    EnterCriticalSection(&d2d_state_cs);
+    for (i = 0; i < ARRAY_SIZE(d2d_state_owners); ++i)
+    {
+        struct d2d_device_context *context = d2d_state_owners[i].context;
+
+        if (context && context->cs == factory_cs)
+            d2d_device_context_restore_app_state_locked(context);
+    }
+    LeaveCriticalSection(&d2d_state_cs);
+}
+
+/* Called from d2d_device_context_draw with render_target->cs (if any) held. Returns FALSE
+ * if our state couldn't be kept bound; the caller then swaps around this draw only. */
+static BOOL d2d_device_context_activate_state(struct d2d_device_context *context, ID3D11DeviceContext1 *d3d_context)
+{
+    unsigned int i, slot = ARRAY_SIZE(d2d_state_owners);
+    BOOL ret = FALSE;
+
+    if (context->d2d_state_active)
+        return TRUE;
+    if (!d2d_lazy_state_enabled())
+        return FALSE;
+
+    EnterCriticalSection(&d2d_state_cs);
+    for (i = 0; i < ARRAY_SIZE(d2d_state_owners); ++i)
+    {
+        struct d2d_device_context *other = d2d_state_owners[i].context;
+
+        if (other && d2d_state_owners[i].device == context->d3d_device)
+        {
+            /* Another context owns this device's state. Its lock may be a different factory
+             * lock; don't block on it (lock order), just use per-draw swapping this time. */
+            if (other->cs && other->cs != context->cs && !TryEnterCriticalSection(other->cs))
+                goto done;
+            d2d_device_context_restore_app_state_locked(other);
+            if (other->cs && other->cs != context->cs)
+                LeaveCriticalSection(other->cs);
+        }
+    }
+    for (i = 0; i < ARRAY_SIZE(d2d_state_owners); ++i)
+    {
+        if (!d2d_state_owners[i].context)
+        {
+            slot = i;
+            break;
+        }
+    }
+    if (slot == ARRAY_SIZE(d2d_state_owners))
+        goto done;
+
+    ID3D11DeviceContext1_SwapDeviceContextState(d3d_context, context->d3d_state, &context->app_state);
+    context->d2d_state_active = TRUE;
+    d2d_state_owners[slot].device = context->d3d_device;
+    d2d_state_owners[slot].context = context;
+    ret = TRUE;
+
+done:
+    LeaveCriticalSection(&d2d_state_cs);
+    return ret;
+}
