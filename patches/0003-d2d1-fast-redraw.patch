+/* Altium-on-Wine kit: return a buffer (with a reference the caller releases) holding
+ * geometry data. Buffers are cached per geometry for the first device that draws it and
+ * recreated if the data size changes (e.g. a path drawn before it was closed). */
+enum d2d_geometry_buffer
 {
+    D2D_GB_FILL_IB, D2D_GB_FILL_VB, D2D_GB_FILL_BEZIER_VB, D2D_GB_FILL_ARC_VB,
+    D2D_GB_OUTLINE_IB, D2D_GB_OUTLINE_VB, D2D_GB_OUTLINE_BEZIER_IB, D2D_GB_OUTLINE_BEZIER_VB,
+    D2D_GB_OUTLINE_ARC_IB, D2D_GB_OUTLINE_ARC_VB,
+};
