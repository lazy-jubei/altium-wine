+/* Source-built DIB copy interface. LGPL-2.1-or-later. */
+#ifndef __WINE_GDI_COPY_H
+#define __WINE_GDI_COPY_H
+struct wine_dib_copy_tables
+{
+    unsigned int prefix_size, rect_offset, stride_offset, bits_offset;
+    unsigned int bit_count_offset, width_offset, height_offset, compression_offset;
+    void *copy_rect;
+    void *table1;
+    void *table2;
+};
+#define WINE_DIB_COPY_TABLES_VERSION 1
+#endif
