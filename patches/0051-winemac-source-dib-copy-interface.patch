+/* The matching Mac driver can discover the actual source-built tables without
+ * depending on a particular link address, compiler prologue or Mach-O UUID.
+ * Version/size and every consumed prefix offset are checked by the caller. */
+__attribute__((visibility("default")))
+int __wine_get_dib_copy_tables(unsigned int version, unsigned int size, struct wine_dib_copy_tables *tables)
+{
+    if (version != WINE_DIB_COPY_TABLES_VERSION || size != sizeof(*tables) || !tables) return 0;
+    *tables = (struct wine_dib_copy_tables){
+        .prefix_size = offsetof(dib_info, bits) + sizeof(void *),
+        .rect_offset = offsetof(dib_info, rect),
+        .stride_offset = offsetof(dib_info, stride),
+        .bits_offset = offsetof(dib_info, bits),
+        .bit_count_offset = offsetof(dib_info, bit_count),
+        .width_offset = offsetof(dib_info, width),
+        .height_offset = offsetof(dib_info, height),
+        .compression_offset = offsetof(dib_info, compression),
+        .copy_rect = copy_rect_32,
+        .table1 = (void *)&funcs_8888.copy_rect,
+        .table2 = (void *)&funcs_32.copy_rect,
+    };
+    return 1;
+}
