+static int altium_install_copy_hook(altium_copy_func code, altium_copy_func *table1, altium_copy_func *table2)
+{
+    uintptr_t page_address;
+    size_t page;
+    if (!code || !table1 || !table2 || *table1 != code || *table2 != code) return 0;
+    page = getpagesize(); page_address = (uintptr_t)table1 & ~(uintptr_t)(page - 1);
+    if (((uintptr_t)table2 & ~(uintptr_t)(page - 1)) != page_address) return 0;
+    if (mach_vm_protect(mach_task_self(), page_address, page, 0,
+                         VM_PROT_READ | VM_PROT_WRITE | VM_PROT_COPY) != KERN_SUCCESS) return 0;
+
+    original_copy = code;
+    copy_table1 = table1; copy_table2 = table2;
+    *table1 = altium_parallel_copy; *table2 = altium_parallel_copy;
+    mach_vm_protect(mach_task_self(), page_address, page, 0, VM_PROT_READ);
+    return 1;
+}
+
+static int altium_hook_source_copy(void)
+{
+    struct wine_dib_copy_tables info;
+    int (*query)(unsigned int, unsigned int, struct wine_dib_copy_tables *);
+    query = dlsym(RTLD_DEFAULT, "__wine_get_dib_copy_tables");
+    if (!query || !query(WINE_DIB_COPY_TABLES_VERSION, sizeof(info), &info)) return 0;
+    if (info.prefix_size != sizeof(struct altium_dib) ||
+        info.bit_count_offset != offsetof(struct altium_dib, bit_count) ||
+        info.width_offset != offsetof(struct altium_dib, width) ||
+        info.height_offset != offsetof(struct altium_dib, height) ||
+        info.compression_offset != offsetof(struct altium_dib, compression) ||
+        info.rect_offset != offsetof(struct altium_dib, rect) ||
+        info.stride_offset != offsetof(struct altium_dib, stride) ||
+        info.bits_offset != offsetof(struct altium_dib, bits)) return 0;
+    return altium_install_copy_hook((altium_copy_func)info.copy_rect, info.table1, info.table2);
+}
