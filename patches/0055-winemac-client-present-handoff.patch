+/* Track a single contiguous painted rectangle. Disconnected updates
+ * must never count as coverage of the pixels in between. */
+void record_opaque_paint( dibdrv_physdev *dev, const struct clipped_rects *clipped )
+{
+    RECT *paint = dev->opaque_paint;
+    if (!paint) return;
+
+    for (int i = 0; i < clipped->count; i++)
+    {
+        const RECT *rect = &clipped->rects[i];
+        LONGLONG area = (LONGLONG)(rect->right - rect->left) * (rect->bottom - rect->top);
+        LONGLONG previous = (LONGLONG)(paint->right - paint->left) * (paint->bottom - paint->top);
+        if (area <= previous) continue;
+
+        *paint = *rect;
+        OffsetRect( paint, dev->dib.rect.left, dev->dib.rect.top );
+    }
 }
 
