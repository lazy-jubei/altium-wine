+        /* Inactive Win32 editor branches can already have empty bounds.
+         * The native compositor retains their last actual viewport, so use
+         * those bounds to distinguish a canvas replacement from a panel hide. */
+        BOOL sharesViewport = NO;
+        NSRect outgoing = view.frame;
+        for (NSView *child in self.subviews)
+        {
+            if (child == view || ![child isKindOfClass:[WineContentView class]] ||
+                ![(WineContentView *)child metalViewForReadback]) continue;
+            NSRect incoming = child.frame;
+            if (!NSIsEmptyRect(incoming) && NSEqualPoints(outgoing.origin, incoming.origin) &&
+                (NSContainsRect(outgoing, incoming) || NSContainsRect(incoming, outgoing)))
+            {
+                sharesViewport = YES;
+                break;
+            }
+        }
+        if (!sharesViewport) return NO;
+
+        if (!retiredClients) retiredClients = [[NSMutableArray alloc] init];
+        [retiredClients addObject:view];
+        view.clientRetired = YES;
+        view.clientBackingReady = NO;
+        [self addSubview:view positioned:NSWindowBelow relativeTo:nil];
+
+        /* Most handoffs finish at the next present or opaque GDI update.
+         * Bound retention if the application hides the view without replacing it. */
+        NSUInteger retirement = ++view.clientRetirement;
+        __weak WineContentView *weakRoot = self, *weakView = view;
+        dispatch_after(dispatch_time(DISPATCH_TIME_NOW, 750 * NSEC_PER_MSEC), dispatch_get_main_queue(), ^{
+            WineContentView *root = [weakRoot retain], *previous = [weakView retain];
+            if (previous.clientRetirement == retirement) [root finishRetiredClient:previous];
+            [previous release];
+            [root release];
+        });
+        return YES;
+    }
+
+    - (BOOL)removeRetiredClient:(WineContentView *)view
+    {
+        if (!retiredClients.count || [retiredClients indexOfObjectIdenticalTo:view] == NSNotFound) return NO;
+        [retiredClients removeObjectIdenticalTo:view];
+        view.clientRetired = NO;
+        view.clientBackingReady = NO;
+        return YES;
+    }
